---
// WorkflowCard.astro - Card limpo, colorido individualmente, direto e sem poluição
import type { WorkflowStep } from '../../data/workflow-steps';

interface Props {
  stepData: WorkflowStep;
}

const { stepData } = Astro.props;
const { step, title, summary, icon, theme, accentColor, bgColor, borderColor } = stepData;
---

<div 
  class={`workflow-navy-card ${theme}`} 
  data-accordion-card
  style={`--card-accent: ${accentColor}; --card-bg: ${bgColor}; --card-border: ${borderColor};`}
  role="button"
  tabindex="0"
  aria-expanded="false"
  aria-controls={`accordion-body-${step}`}
>
  <div class="card-inner-flow">
    <!-- Topo: Ícone -->
    <div class="card-icon-container" style={`color: ${accentColor}; background: rgba(255, 255, 255, 0.08); border-color: ${accentColor}40;`}>
      {icon === "user-plus" && (
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
          <circle cx="8.5" cy="7" r="4"></circle>
          <line x1="20" y1="8" x2="20" y2="14"></line>
          <line x1="23" y1="11" x2="17" y2="11"></line>
        </svg>
      )}
      {icon === "calendar" && (
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
      )}
      {icon === "file-text" && (
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
          <polyline points="10 9 9 9 8 9"></polyline>
        </svg>
      )}
      {icon === "layers" && (
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
          <polyline points="2 17 12 22 22 17"></polyline>
          <polyline points="2 12 12 17 22 12"></polyline>
        </svg>
      )}
      {icon === "credit-card" && (
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
          <line x1="1" y1="10" x2="23" y2="10"></line>
        </svg>
      )}
      {icon === "trending-up" && (
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline>
          <polyline points="16 7 22 7 22 13"></polyline>
        </svg>
      )}
    </div>

    <!-- Título do Card -->
    <h3 class="card-title">{title}</h3>

    <!-- Subtítulo: logo abaixo do título -->
    <div class="accordion-body" id={`accordion-body-${step}`}>
      <div class="accordion-inner">
        <p class="card-summary">{summary}</p>
      </div>
    </div>

    <!-- Gatilho Ver mais / Ver menos: posicionado na parte mais inferior do card -->
    <div class="workflow-card-trigger">
      <span class="toggle-text">Ver mais</span>
      <svg class="chevron-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </div>
  </div>
</div>

<style>
  .workflow-navy-card {
    background: var(--card-bg, #142D5B);
    border: 1px solid var(--card-border, #1E3D78);
    border-radius: clamp(16px, 2.2vmin, 22px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    box-sizing: border-box;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    cursor: pointer;
    user-select: none;
    outline: none;
  }

  .workflow-navy-card:focus-visible {
    outline: 2px solid var(--card-accent, #00E5FF);
    outline-offset: 3px;
  }

  .workflow-navy-card:hover {
    transform: translateY(-4px);
    border-color: var(--card-accent);
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.35), 0 0 20px rgba(0, 229, 255, 0.15);
  }

  .workflow-navy-card.is-open {
    border-color: var(--card-accent);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
  }

  .card-inner-flow {
    padding: clamp(1.25rem, 2.5vmin, 1.8rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.85rem;
    box-sizing: border-box;
    width: 100%;
    min-height: 100%;
    flex: 1;
  }

  .card-icon-container {
    width: 48px;
    height: 48px;
    border-radius: 14px;
    border: 1px solid;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.25s ease;
  }

  .workflow-navy-card:hover .card-icon-container {
    transform: scale(1.08);
  }

  .card-title {
    font-size: clamp(1.05rem, 1.8vmin, 1.28rem);
    font-weight: 800;
    color: #FFFFFF;
    margin: 0;
    line-height: 1.3;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  /* Subtítulo logo abaixo do título com animação ultra suave */
  .accordion-body {
    width: 100%;
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition: grid-template-rows 0.4s cubic-bezier(0.2, 0.9, 0.3, 1), 
                opacity 0.3s ease,
                margin-top 0.3s ease;
    overflow: hidden;
    margin-top: 0;
  }

  .workflow-navy-card.is-open .accordion-body {
    grid-template-rows: 1fr;
    opacity: 1;
    margin-top: 0.25rem;
  }

  .accordion-inner {
    min-height: 0;
    overflow: hidden;
  }

  .card-summary {
    font-size: clamp(0.92rem, 1.5vmin, 1.05rem);
    color: #E2E8F0;
    line-height: 1.45;
    margin: 0;
    padding-top: 0.5rem;
    border-top: 1px dashed rgba(255, 255, 255, 0.15);
    font-weight: 500;
  }

  /* Gatilho Ver mais / Ver menos posicionado na parte mais inferior do card */
  .workflow-card-trigger {
    background: transparent;
    border: none;
    padding: 0;
    margin-top: auto;
    padding-top: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--card-accent, #00E5FF);
    font-family: inherit;
    transition: opacity 0.2s ease;
    pointer-events: none; /* O clique é tratado no card inteiro */
  }

  .workflow-navy-card:hover .workflow-card-trigger {
    opacity: 0.85;
  }

  .chevron-icon {
    transition: transform 0.25s ease;
  }

  .workflow-navy-card.is-open .chevron-icon {
    transform: rotate(180deg);
  }
</style>
