---
// WorkflowCard.astro - Componente atômico para cards das 6 etapas clínicas

interface Props {
  step: string;
  title: string;
  text: string;
  icon: string;
}

const { step, title, text, icon } = Astro.props;
---

<div class="workflow-navy-card">
  <div class="card-top-row">
    <div class="card-icon-container">
      {icon === "user-plus" && (
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
          <circle cx="8.5" cy="7" r="4"></circle>
          <line x1="20" y1="8" x2="20" y2="14"></line>
          <line x1="23" y1="11" x2="17" y2="11"></line>
        </svg>
      )}
      {icon === "calendar" && (
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="16" y1="2" x2="16" y2="6"></line>
          <line x1="8" y1="2" x2="8" y2="6"></line>
          <line x1="3" y1="10" x2="21" y2="10"></line>
        </svg>
      )}
      {icon === "file-text" && (
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
          <polyline points="14 2 14 8 20 8"></polyline>
          <line x1="16" y1="13" x2="8" y2="13"></line>
          <line x1="16" y1="17" x2="8" y2="17"></line>
          <polyline points="10 9 9 9 8 9"></polyline>
        </svg>
      )}
      {icon === "layers" && (
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
          <polyline points="2 17 12 22 22 17"></polyline>
          <polyline points="2 12 12 17 22 12"></polyline>
        </svg>
      )}
      {icon === "credit-card" && (
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
          <line x1="1" y1="10" x2="23" y2="10"></line>
        </svg>
      )}
      {icon === "trending-up" && (
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline>
          <polyline points="16 7 22 7 22 13"></polyline>
        </svg>
      )}
    </div>
    <span class="card-step-num">{step}</span>
  </div>
  <h3 class="card-title">{title}</h3>
  <p class="card-text">{text}</p>
</div>

<style>
  .workflow-navy-card {
    background: #142D5B;
    border: 1px solid #1E3D78;
    border-radius: clamp(14px, 2vmin, 20px);
    padding: clamp(0.9rem, 2vmin, 1.4rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
    box-sizing: border-box;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .workflow-navy-card:hover {
    transform: translateY(-2px);
    border-color: #00C6FF;
  }

  .card-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-bottom: clamp(0.5rem, 1.2vmin, 0.85rem);
  }

  .card-icon-container {
    width: clamp(34px, 4.5vmin, 40px);
    height: clamp(34px, 4.5vmin, 40px);
    border-radius: 10px;
    background: rgba(0, 198, 255, 0.12);
    border: 1px solid rgba(0, 198, 255, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #00C6FF;
    flex-shrink: 0;
  }

  .card-step-num {
    font-size: clamp(0.85rem, 1.3vmin, 1.05rem);
    font-weight: 800;
    color: #64748B;
    letter-spacing: -0.02em;
  }

  .card-title {
    font-size: clamp(0.95rem, 1.5vmin, 1.15rem);
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 clamp(0.3rem, 0.8vmin, 0.5rem) 0;
    line-height: 1.25;
  }

  .card-text {
    font-size: clamp(0.78rem, 1.2vmin, 0.88rem);
    color: #94A3B8;
    line-height: 1.45;
    margin: 0;
  }
</style>
