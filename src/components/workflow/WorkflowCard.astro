---
// WorkflowCard.astro - Componente atômico para card com sanfona/accordion individual
import type { WorkflowStep } from '../../data/workflow-steps';

interface Props {
  stepData: WorkflowStep;
}

const { stepData } = Astro.props;
const { step, title, summary, icon, badge, details } = stepData;
---

<div class="workflow-navy-card" data-accordion-card>
  <button
    type="button"
    class="workflow-card-trigger"
    aria-expanded="false"
    aria-controls={`accordion-body-${step}`}
  >
    <div class="card-top-row">
      <div class="card-icon-container">
        {icon === "user-plus" && (
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="8.5" cy="7" r="4"></circle>
            <line x1="20" y1="8" x2="20" y2="14"></line>
            <line x1="23" y1="11" x2="17" y2="11"></line>
          </svg>
        )}
        {icon === "calendar" && (
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
        )}
        {icon === "file-text" && (
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
            <polyline points="10 9 9 9 8 9"></polyline>
          </svg>
        )}
        {icon === "layers" && (
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
            <polyline points="2 17 12 22 22 17"></polyline>
            <polyline points="2 12 12 17 22 12"></polyline>
          </svg>
        )}
        {icon === "credit-card" && (
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
            <line x1="1" y1="10" x2="23" y2="10"></line>
          </svg>
        )}
        {icon === "trending-up" && (
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline>
            <polyline points="16 7 22 7 22 13"></polyline>
          </svg>
        )}
      </div>

      <div class="card-step-badge-wrap">
        {badge && <span class="card-tag-badge">{badge}</span>}
        <span class="card-step-num">{step}</span>
      </div>
    </div>

    <div class="card-header-main">
      <h3 class="card-title">{title}</h3>
      <p class="card-summary">{summary}</p>
    </div>

    <div class="accordion-toggle-indicator">
      <span class="toggle-text">Ver detalhes</span>
      <svg class="chevron-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </div>
  </button>

  <!-- Sanfona expansível com o conteúdo rico e detalhado -->
  <div class="accordion-body" id={`accordion-body-${step}`} hidden>
    <div class="accordion-inner">
      <div class="accordion-highlight">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#00C6FF" stroke-width="2.5">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <strong>{details.highlight}</strong>
      </div>
      <p class="accordion-description">{details.description}</p>
      
      {details.chips && details.chips.length > 0 && (
        <div class="accordion-chips-list">
          {details.chips.map((chip) => (
            <span class="accordion-chip">
              <span class="dot-bullet"></span>
              {chip}
            </span>
          ))}
        </div>
      )}
    </div>
  </div>
</div>

<style>
  .workflow-navy-card {
    background: #142D5B;
    border: 1px solid #1E3D78;
    border-radius: clamp(14px, 2vmin, 20px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
    box-sizing: border-box;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    overflow: hidden;
  }

  .workflow-navy-card:hover {
    border-color: rgba(0, 198, 255, 0.6);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  .workflow-navy-card.is-open {
    border-color: #00C6FF;
    background: #17356B;
    box-shadow: 0 10px 28px rgba(0, 198, 255, 0.15);
  }

  .workflow-card-trigger {
    width: 100%;
    background: transparent;
    border: none;
    padding: clamp(1rem, 2vmin, 1.4rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    cursor: pointer;
    color: inherit;
    font-family: inherit;
    box-sizing: border-box;
  }

  .card-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 0.75rem;
  }

  .card-icon-container {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: rgba(0, 198, 255, 0.12);
    border: 1px solid rgba(0, 198, 255, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #00C6FF;
    flex-shrink: 0;
  }

  .card-step-badge-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .card-tag-badge {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    background: rgba(0, 198, 255, 0.15);
    color: #38BDF8;
    border: 1px solid rgba(0, 198, 255, 0.25);
  }

  .card-step-num {
    font-size: 0.95rem;
    font-weight: 800;
    color: #64748B;
    letter-spacing: -0.02em;
  }

  .card-header-main {
    margin-bottom: 0.85rem;
    width: 100%;
  }

  .card-title {
    font-size: clamp(1.05rem, 1.6vmin, 1.25rem);
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 0.35rem 0;
    line-height: 1.25;
  }

  .card-summary {
    font-size: clamp(0.82rem, 1.2vmin, 0.9rem);
    color: #94A3B8;
    line-height: 1.45;
    margin: 0;
  }

  /* Indicador Sanfona */
  .accordion-toggle-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    font-weight: 700;
    color: #38BDF8;
    padding-top: 0.35rem;
    border-top: 1px dashed rgba(255, 255, 255, 0.12);
    width: 100%;
    margin-top: auto;
  }

  .chevron-icon {
    transition: transform 0.25s ease;
  }

  .workflow-navy-card.is-open .chevron-icon {
    transform: rotate(180deg);
  }

  .workflow-navy-card.is-open .toggle-text {
    color: #00C6FF;
  }

  /* Conteúdo da Sanfona */
  .accordion-body {
    padding: 0 clamp(1rem, 2vmin, 1.4rem) clamp(1rem, 2vmin, 1.4rem);
    animation: fadeInAccordion 0.2s ease-in-out;
  }

  .accordion-body[hidden] {
    display: none;
  }

  @keyframes fadeInAccordion {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .accordion-inner {
    border-top: 1px solid rgba(0, 198, 255, 0.2);
    padding-top: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .accordion-highlight {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    font-size: 0.82rem;
    color: #E2E8F0;
    line-height: 1.35;
  }

  .accordion-highlight svg {
    flex-shrink: 0;
    margin-top: 2px;
  }

  .accordion-description {
    font-size: 0.8rem;
    color: #94A3B8;
    line-height: 1.5;
    margin: 0;
  }

  .accordion-chips-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.25rem;
  }

  .accordion-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    padding: 0.2rem 0.5rem;
    font-size: 0.72rem;
    color: #CBD5E1;
    font-weight: 500;
  }

  .dot-bullet {
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: #00C6FF;
  }
</style>
