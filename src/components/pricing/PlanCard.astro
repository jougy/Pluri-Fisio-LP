---
// PlanCard.astro - Componente atômico para renderizar cada card de plano na PricingSection com alta legibilidade
import type { Plan } from '../../data/pricing-plans';

interface Props {
  plan: Plan;
}

const { plan } = Astro.props;
---

<div
  class:list={["plan-card", { featured: plan.featured }]}
  id={`card-${plan.id}`}
  data-monthly={plan.monthly}
  data-audience={plan.audience}
>
  {plan.badge && (
    <div class="card-badge">{plan.badge}</div>
  )}

  <div class="card-header">
    <h3 class="plan-name">{plan.name}</h3>
    <p class="plan-tagline">{plan.tagline}</p>
  </div>

  <div class="price-wrapper">
    <div class="price-main-row">
      <span class="price-number" data-price-main>{Number.isInteger(plan.monthly) ? `R$ ${plan.monthly}/mês` : `R$ ${plan.monthly.toFixed(2).replace('.', ',')}/mês`}</span>
    </div>
    <div class="price-sub-note" data-price-sub>Cobrado mensalmente</div>
  </div>

  <!-- Lista Completa de Benefícios com Alta Legibilidade e Diferenças em Negrito -->
  <ul class="features-list" role="list">
    {plan.features.map(feature => (
      <li class="feature-item">
        <svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span>
          {feature.bold ? <strong>{feature.text}</strong> : feature.text}
        </span>
      </li>
    ))}
  </ul>

  <div class="card-footer">
    <a
      href={`http://pluri.health/auth/cadastro?plan=${plan.id}&cycle=monthly`}
      class:list={["plan-cta-btn", plan.featured ? "btn-featured" : "btn-standard"]}
      data-cta-default={plan.cta}
      data-plan-id={plan.id}
      data-plan-name={plan.name}
      data-audience={plan.audience}
    >
      <span>{plan.cta}</span>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
  </div>
</div>

<style>
  .plan-card {
    position: relative;
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 20px;
    padding: clamp(1.4rem, 2.5vw, 2rem);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    box-sizing: border-box;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
  }

  .plan-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 36px -8px rgba(15, 23, 42, 0.1);
  }

  .plan-card.featured {
    border: 2px solid #0072FF;
    box-shadow: 0 12px 32px -6px rgba(0, 114, 255, 0.16);
    background: linear-gradient(180deg, #FAFCFF 0%, #FFFFFF 100%);
  }

  .card-badge {
    position: absolute;
    top: -12px;
    right: 20px;
    background: linear-gradient(135deg, #0072FF, #00C6FF);
    color: #FFFFFF;
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    box-shadow: 0 4px 10px rgba(0, 114, 255, 0.3);
  }

  .plan-name {
    font-size: 1.35rem;
    font-weight: 800;
    color: #0F172A;
    margin: 0 0 0.35rem 0;
  }

  .plan-tagline {
    font-size: 0.88rem;
    color: #64748B;
    margin: 0 0 1.25rem 0;
    line-height: 1.4;
    min-height: 2.8em;
  }

  .price-wrapper {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 14px;
    padding: 0.85rem 1.1rem;
    margin-bottom: 1.4rem;
  }

  .price-main-row {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
  }

  .currency-symbol {
    font-size: 1.05rem;
    font-weight: 700;
    color: #334155;
  }

  .price-number {
    font-size: 2.1rem;
    font-weight: 800;
    color: #0F172A;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .billing-period {
    font-size: 0.88rem;
    color: #64748B;
    font-weight: 500;
  }

  .price-sub-note {
    font-size: 0.76rem;
    color: #64748B;
    margin-top: 0.25rem;
  }

  .features-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.6rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    flex: 1;
  }

  .feature-item {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.88rem;
    color: #334155;
    line-height: 1.45;
  }

  .check-icon {
    color: #10B981;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .plan-cta-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    width: 100%;
    padding: 0.85rem 1.25rem;
    border-radius: 12px;
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
    box-sizing: border-box;
  }

  .btn-featured {
    background: #0072FF;
    color: #FFFFFF;
    box-shadow: 0 4px 14px rgba(0, 114, 255, 0.25);
  }

  .btn-featured:hover {
    background: #005FD8;
    transform: translateY(-1px);
  }

  .btn-standard {
    background: #F1F5F9;
    color: #1E293B;
  }

  .btn-standard:hover {
    background: #E2E8F0;
    color: #0F172A;
  }

  @media (max-width: 860px) {
    .plan-card {
      padding: 1.35rem 1.15rem;
    }
    .plan-tagline {
      min-height: auto;
      margin-bottom: 1rem;
    }
  }
</style>
