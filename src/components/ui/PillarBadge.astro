---
// PillarBadge.astro - Componente atômico para pílulas de benefícios com ícone

interface Props {
  text: string;
  icon?: "lightning" | "dashboard" | "pulse";
}

const { text, icon = "lightning" } = Astro.props;
---

<div class="pillar-pill">
  {icon === "lightning" && (
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
      <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"></path>
    </svg>
  )}
  {icon === "dashboard" && (
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
      <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
      <line x1="9" y1="3" x2="9" y2="21"></line>
    </svg>
  )}
  {icon === "pulse" && (
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
      <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
    </svg>
  )}
  <span>{text}</span>
</div>

<style>
  .pillar-pill {
    display: inline-flex;
    align-items: center;
    gap: clamp(0.4rem, 0.9vmin, 0.6rem);
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    color: #334155;
    font-size: clamp(0.75rem, 1.3vmin, 0.92rem);
    font-weight: 600;
    padding: clamp(0.45rem, 1.1vmin, 0.7rem) clamp(0.85rem, 1.8vmin, 1.25rem);
    border-radius: 9999px;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.03);
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .pillar-pill:hover {
    border-color: #BFDBFE;
    background: #F0F7FF;
    transform: translateY(-1px);
  }

  .pillar-pill svg {
    color: #0072FF;
    flex-shrink: 0;
    width: clamp(16px, 2vmin, 20px);
    height: clamp(16px, 2vmin, 20px);
  }

  @media (max-width: 860px), (max-aspect-ratio: 1/1) {
    .pillar-pill {
      padding: 0.35rem 0.65rem;
      font-size: clamp(0.68rem, 2.5vw, 0.78rem);
    }
  }
</style>
