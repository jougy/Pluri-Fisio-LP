---
// PricingSection.astro - Seção 4: Planos (Arquitetura CRO com seletor em 1 linha, 7 dias grátis e bônus de lançamento)
import { BILLING_CYCLES, PROF_PLANS, CLINIC_PLANS } from '../../data/pricing-plans';
import PlanCard from '../pricing/PlanCard.astro';
---

<section
  id="planos"
  aria-labelledby="planos-titulo"
  class="snap-page plans-section"
>
  <div class="plans-container">
    <!-- Header com Posicionamento Limpo -->
    <div class="plans-header">
      <h2 id="planos-titulo" class="plans-main-heading">
        Planos
      </h2>

      <!-- Bônus Especial de Lançamento em Destaque -->
      <div class="launch-consulting-badge">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
        </svg>
        <span><strong>Lançamento Especial:</strong> Consultoria VIP de implantação e uso inclusa para os primeiros inscritos!</span>
      </div>

      <!-- Seletor de Perfil Master: 3 Abas sempre em UMA linha só (Profissional, Clínica, Enterprise) -->
      <div class="audience-toggle-wrapper" role="tablist" aria-label="Seletor de Perfil">
        <button
          type="button"
          id="btnAudienceProf"
          class="audience-toggle-btn active"
          data-audience="prof"
          role="tab"
          aria-selected="true"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          <span>Profissional</span>
        </button>

        <button
          type="button"
          id="btnAudienceClinic"
          class="audience-toggle-btn"
          data-audience="clinic"
          role="tab"
          aria-selected="false"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M3 21h18"></path><path d="M9 8h1"></path><path d="M9 12h1"></path><path d="M9 16h1"></path><path d="M14 8h1"></path><path d="M14 12h1"></path><path d="M14 16h1"></path><path d="M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16"></path></svg>
          <span>Clínica</span>
        </button>

        <button
          type="button"
          id="btnAudienceEnterprise"
          class="audience-toggle-btn"
          data-audience="enterprise"
          role="tab"
          aria-selected="false"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
          <span>Enterprise</span>
        </button>
      </div>

      <!-- Ciclos de Cobrança Otimizados: Botão de Grátis + Mensal + Trimestral + Anual -->
      <div
        role="group"
        aria-label="Ciclo de cobrança"
        class="cycles-switcher"
        id="cyclesSwitcherGroup"
      >
        {BILLING_CYCLES.map((c) => (
          <button
            type="button"
            data-cycle={c.id}
            class={`cycle-btn ${c.id === 'mensal' ? 'active' : ''} ${c.id === 'free' ? 'btn-cycle-free' : ''}`}
          >
            <span>{c.label}</span>
            {c.note ? <span class="cycle-note">{c.note}</span> : null}
          </button>
        ))}
      </div>
    </div>

    <!-- Card Especial de Destaque: Plano Gratuito por 7 dias (Exibido quando ciclo 'free' estiver ativo) -->
    <div class="free-plan-card-pane" id="freePlanHighlightPane" style="display: none;">
      <div class="free-plan-special-card">
        <div class="free-card-badge">7 DIAS GRÁTIS</div>
        <div class="free-card-header">
          <h3 class="free-card-title">Plano Gratuito de Experimentação</h3>
          <p class="free-card-desc">
            Acesso completo a todas as funções para você comprovar a velocidade do sistema na sua rotina clínica.
          </p>
        </div>

        <div class="free-card-specs">
          <div class="free-spec-item">
            <span class="spec-val">7 Dias</span>
            <span class="spec-label">Duração do teste</span>
          </div>
          <div class="free-spec-divider"></div>
          <div class="free-spec-item">
            <span class="spec-val">20</span>
            <span class="spec-label">Atendimentos inclusos</span>
          </div>
          <div class="free-spec-divider"></div>
          <div class="free-spec-item">
            <span class="spec-val">R$ 0</span>
            <span class="spec-label">Sem cobrança inicial</span>
          </div>
        </div>

        <ul class="free-features-list">
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span><strong>Acesso completo</strong> ao prontuário eletrônico e agenda com WhatsApp</span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span><strong>Duplicação em 1 toque</strong> para evolução ultra-rápida</span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span><strong>Consultoria de uso de lançamento</strong> para configurar seus formulários</span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#16A34A" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Cancele a qualquer momento com apenas 1 clique</span>
          </li>
        </ul>

        <div class="free-card-footer">
          <a
            href="https://plurifisio.com.br/planos?cycle=free"
            class="free-card-cta"
          >
            <span>Começar 7 Dias Grátis Agora</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Grupo 1: Planos Profissional (Ativo por Padrão) -->
    <div class="plans-list audience-group" id="plansGroupProf">
      {PROF_PLANS.map((plan) => (
        <PlanCard plan={plan} />
      ))}
    </div>

    <!-- Grupo 2: Planos Clínica (Alternável) -->
    <div class="plans-list audience-group" id="plansGroupClinic" style="display: none;">
      {CLINIC_PLANS.map((plan) => (
        <PlanCard plan={plan} />
      ))}
    </div>

    <!-- Indicador Visual Dinâmico para Mobile (Dots + Contador + Hint de Deslize) -->
    <div class="plans-mobile-nav" id="plansMobileNav">
      <div class="plans-dots-track" id="plansDotsTrack">
        <button type="button" class="plan-nav-dot active" data-index="0" aria-label="Plano 1: Básico">
          <span>Básico</span>
        </button>
        <button type="button" class="plan-nav-dot" data-index="1" aria-label="Plano 2: Médio">
          <span>Médio</span>
        </button>
        <button type="button" class="plan-nav-dot" data-index="2" aria-label="Plano 3: Top">
          <span>Top</span>
        </button>
      </div>
      <div class="plans-peek-hint">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14"></path><path d="M12 5l7 7-7 7"></path></svg>
        <span>Deslize para ver mais planos (3 opções)</span>
      </div>
    </div>

    <!-- Grupo 3: Solução Enterprise Completa e Imponente (3ª Aba) -->
    <div class="enterprise-pane audience-group" id="plansGroupEnterprise" style="display: none;">
      <div class="enterprise-hero-card">
        <div class="enterprise-badge-highlight">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
          <span>Grandes Redes e Hospitais</span>
        </div>
        <h3 class="enterprise-heading">Soluções Corporativas Sob Medida</h3>
        <p class="enterprise-lead">
          Para hospitais, franquias, centros universitários e redes de reabilitação física com mais de 30 profissionais que precisam de governança avançada, banco de dados isolado e suporte 24/7.
        </p>

        <div class="enterprise-features-grid">
          <div class="enterprise-feature-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <div>
              <strong>Migração Assistida VIP</strong>
              <p>Nossos engenheiros importam todo o seu banco de dados de prontuários antigos sem risco de perda.</p>
            </div>
          </div>

          <div class="enterprise-feature-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <div>
              <strong>Múltiplas Unidades e Filiais</strong>
              <p>Controle centralizado com permissões hierárquicas por unidade, gestor e profissional.</p>
            </div>
          </div>

          <div class="enterprise-feature-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <div>
              <strong>SLA Dedicado & Gerente de Contas</strong>
              <p>Canal direto com time de desenvolvimento e treinamento presencial ou remoto para toda a equipe.</p>
            </div>
          </div>

          <div class="enterprise-feature-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <div>
              <strong>Integrações Customizadas</strong>
              <p>Conexão via API com ERPs hospitalares, sistemas de faturamento TISS/TUSS e biometria.</p>
            </div>
          </div>
        </div>

        <div class="enterprise-cta-block">
          <a
            href="https://wa.me/5511999999999?text=Ol%C3%A1%2C%20gostaria%20de%20conversar%20sobre%20o%20Plano%20Enterprise%20do%20Pluri%20Fisio"
            target="_blank"
            rel="noopener"
            class="enterprise-primary-btn"
          >
            <span>Falar com Consultor Corporativo</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Rodapé Sutil e Informativo (Sem cobrir cards) -->
    <div class="plans-footer-info">
      <span>💡 Pagamento no PIX com 5% de desconto · Ativação imediata da conta</span>
    </div>
  </div>
</section>

<style>
  .plans-section {
    position: relative;
    width: 100%;
    min-height: auto;
    background-color: var(--background);
    padding: clamp(3.5rem, 6vw, 6rem) clamp(1rem, 3.5vw, 3rem);
    box-sizing: border-box;
    overflow: hidden;
  }

  .plans-container {
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(1.8rem, 3.5vw, 2.5rem);
    box-sizing: border-box;
  }

  .plans-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    text-align: center;
    max-width: 820px;
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }

  .plans-main-heading {
    font-size: clamp(2rem, 3.8vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #0F172A;
    line-height: 1.2;
    margin: 0;
  }

  /* Badge de Consultoria de Implantação de Lançamento */
  .launch-consulting-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    background: #FEF3C7;
    border: 1px solid #FCD34D;
    color: #92400E;
    padding: 0.45rem 1.15rem;
    border-radius: 9999px;
    font-size: clamp(0.78rem, 1vw, 0.88rem);
    box-shadow: 0 2px 8px rgba(180, 83, 9, 0.08);
  }

  .launch-consulting-badge svg {
    color: #D97706;
    flex-shrink: 0;
  }

  /* Seletor Master: SEMPRE EM UMA LINHA SÓ */
  .audience-toggle-wrapper {
    display: flex;
    flex-direction: row;
    flex-wrap: nowrap !important;
    gap: 0.25rem;
    background: #F1F5F9;
    padding: 0.25rem;
    border-radius: 9999px;
    border: 1px solid #E2E8F0;
    margin-top: 0.4rem;
    justify-content: center;
    max-width: 480px;
    width: 100%;
    box-sizing: border-box;
  }

  .audience-toggle-btn {
    flex: 1 1 0;
    min-width: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.5rem 0.55rem;
    border-radius: 9999px;
    border: none;
    background: transparent;
    color: #64748B;
    font-size: clamp(0.72rem, 1.2vw, 0.85rem);
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
  }

  .audience-toggle-btn svg {
    flex-shrink: 0;
  }

  .audience-toggle-btn:hover {
    color: #0F172A;
  }

  .audience-toggle-btn.active {
    background: #FFFFFF;
    color: #0072FF;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.08);
  }

  /* Seletor de Frequência Compacto com 4 opções */
  .cycles-switcher {
    display: flex;
    justify-content: center;
    gap: 0.25rem;
    border-radius: 999px;
    background-color: #F1F5F9;
    border: 1px solid #E2E8F0;
    padding: 0.25rem;
    margin-top: 0.2rem;
    flex-wrap: nowrap;
    max-width: 520px;
    width: 100%;
    box-sizing: border-box;
  }

  .cycle-btn {
    flex: 1 1 0;
    min-height: 2.2rem;
    border-radius: 999px;
    padding-inline: 0.4rem;
    font-size: clamp(0.72rem, 1.1vw, 0.82rem);
    font-weight: 700;
    color: #64748B;
    background: transparent;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    white-space: nowrap;
  }

  .cycle-btn:hover {
    color: #0F172A;
  }

  .cycle-btn.active {
    background-color: #0F172A;
    color: #FFFFFF;
  }

  .btn-cycle-free {
    color: #16A34A;
    font-weight: 800;
  }

  .btn-cycle-free.active {
    background-color: #16A34A !important;
    color: #FFFFFF !important;
  }

  .cycle-note {
    font-size: 0.68rem;
    color: #0072FF;
    font-weight: 800;
  }

  .cycle-btn.active .cycle-note {
    color: #38BDF8;
  }

  .btn-cycle-free.active .cycle-note {
    color: #DCFCE7;
  }

  /* Pane do Card do Plano Gratuito (quando clicado em 'Grátis') */
  .free-plan-card-pane {
    max-width: 680px;
    margin: 0 auto;
    width: 100%;
    animation: fadeInFreeCard 0.25s ease-out;
  }

  @keyframes fadeInFreeCard {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .free-plan-special-card {
    position: relative;
    background: linear-gradient(135deg, #F0FDF4 0%, #FFFFFF 100%);
    border: 2px solid #22C55E;
    border-radius: 24px;
    padding: clamp(1.75rem, 3.5vw, 2.5rem);
    box-shadow: 0 16px 36px -10px rgba(34, 197, 94, 0.2);
    box-sizing: border-box;
  }

  .free-card-badge {
    position: absolute;
    top: -12px;
    right: 24px;
    background: #16A34A;
    color: #FFFFFF;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 0.25rem 0.85rem;
    border-radius: 9999px;
    letter-spacing: 0.06em;
  }

  .free-card-title {
    font-size: clamp(1.4rem, 2.5vw, 1.8rem);
    font-weight: 800;
    color: #0F172A;
    margin: 0 0 0.5rem 0;
  }

  .free-card-desc {
    font-size: clamp(0.88rem, 1.3vw, 0.98rem);
    color: #475569;
    line-height: 1.5;
    margin: 0 0 1.5rem 0;
  }

  .free-card-specs {
    display: flex;
    align-items: center;
    justify-content: space-around;
    background: #FFFFFF;
    border: 1px solid #DCFCE7;
    border-radius: 16px;
    padding: 1rem 0.75rem;
    margin-bottom: 1.5rem;
  }

  .free-spec-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .spec-val {
    font-size: 1.35rem;
    font-weight: 800;
    color: #16A34A;
  }

  .spec-label {
    font-size: 0.75rem;
    color: #64748B;
    font-weight: 600;
    margin-top: 0.15rem;
  }

  .free-spec-divider {
    width: 1px;
    height: 32px;
    background: #E2E8F0;
  }

  .free-features-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.75rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .free-features-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.9rem;
    color: #334155;
    line-height: 1.4;
  }

  .free-features-list svg {
    flex-shrink: 0;
    margin-top: 2px;
  }

  .free-card-footer {
    display: flex;
  }

  .free-card-cta {
    width: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: #16A34A;
    color: #FFFFFF;
    font-size: 1rem;
    font-weight: 800;
    padding: 0.95rem 1.5rem;
    border-radius: 14px;
    text-decoration: none;
    box-shadow: 0 8px 20px rgba(22, 163, 74, 0.3);
    transition: all 0.2s ease;
  }

  .free-card-cta:hover {
    background: #15803D;
    transform: translateY(-2px);
    box-shadow: 0 12px 26px rgba(22, 163, 74, 0.4);
  }

  /* Grid dos Planos: Organização e Respiro no Desktop */
  .plans-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.2rem, 2.5vw, 2rem);
    width: 100%;
    box-sizing: border-box;
  }

  /* Indicador Mobile de Planos: oculto no desktop */
  .plans-mobile-nav {
    display: none;
  }

  /* Aba Enterprise */
  .enterprise-hero-card {
    background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%);
    border-radius: 24px;
    padding: clamp(2rem, 4vw, 3.5rem);
    color: #FFFFFF;
    box-shadow: 0 16px 40px rgba(15, 23, 42, 0.15);
  }

  .enterprise-badge-highlight {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: rgba(0, 198, 255, 0.15);
    border: 1px solid rgba(0, 198, 255, 0.35);
    color: #38BDF8;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 800;
    margin-bottom: 1.25rem;
  }

  .enterprise-heading {
    font-size: clamp(1.6rem, 2.8vw, 2.4rem);
    font-weight: 800;
    margin: 0 0 0.85rem 0;
    line-height: 1.2;
  }

  .enterprise-lead {
    font-size: clamp(0.95rem, 1.4vw, 1.15rem);
    color: #94A3B8;
    line-height: 1.55;
    max-width: 820px;
    margin: 0 0 2rem 0;
  }

  .enterprise-features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem;
    margin-bottom: 2.5rem;
  }

  .enterprise-feature-item {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .enterprise-feature-item svg {
    color: #38BDF8;
    flex-shrink: 0;
    margin-top: 3px;
  }

  .enterprise-feature-item strong {
    display: block;
    font-size: 1rem;
    color: #FFFFFF;
    margin-bottom: 0.25rem;
  }

  .enterprise-feature-item p {
    font-size: 0.86rem;
    color: #94A3B8;
    line-height: 1.45;
    margin: 0;
  }

  .enterprise-cta-block {
    display: flex;
    justify-content: flex-start;
  }

  .enterprise-primary-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    background: linear-gradient(135deg, #0072FF, #00C6FF);
    color: #FFFFFF;
    padding: 0.95rem 2rem;
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 800;
    text-decoration: none;
    box-shadow: 0 8px 24px rgba(0, 114, 255, 0.3);
    transition: all 0.2s ease;
  }

  .enterprise-primary-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(0, 114, 255, 0.4);
  }

  .plans-footer-info {
    text-align: center;
    font-size: 0.82rem;
    color: #64748B;
    margin-top: 0.5rem;
  }

  /* Responsivo Mobile & Tablets */
  @media (max-width: 860px) {
    .plans-section {
      padding: 3rem 1.25rem;
    }

    .plans-main-heading {
      font-size: 2rem;
    }

    .launch-consulting-badge {
      font-size: 0.76rem;
      border-radius: 12px;
      text-align: left;
    }

    /* Seletor Master: Permanece estritamente em 1 linha sem quebrar */
