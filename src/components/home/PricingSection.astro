---
// PricingSection.astro - Seção 4: Planos (Arquitetura CRO de 3 Abas: Profissional, Clínica e Enterprise)
import { BILLING_CYCLES, PROF_PLANS, CLINIC_PLANS } from '../../data/pricing-plans';
import PlanCard from '../pricing/PlanCard.astro';
---

<section
  id="planos"
  aria-labelledby="planos-titulo"
  class="snap-page plans-section"
>
  <div class="plans-container">
    <!-- Header com Posicionamento e Garantia Gratuita -->
    <div class="plans-header">
      <div class="plans-badge">
        <span>TRANSPARÊNCIA TOTAL</span>
      </div>
      
      <h2 id="planos-titulo" class="plans-main-heading">
        Planos que cabem no momento da sua carreira.
      </h2>

      <!-- Garantia de Entrada CRO: Teste Grátis em Destaque de Confiança -->
      <div class="free-trial-banner">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
        </svg>
        <span><strong>7 dias de teste grátis</strong> em qualquer plano · Sem cartão de crédito · Cancele quando quiser</span>
      </div>

      <!-- Seletor de Perfil Master: 3 Abas (Profissional, Clínica, Enterprise) -->
      <div class="audience-toggle-wrapper" role="tablist" aria-label="Seletor de Perfil">
        <button
          type="button"
          id="btnAudienceProf"
          class="audience-toggle-btn active"
          data-audience="prof"
          role="tab"
          aria-selected="true"
        >
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          <span>Profissional</span>
        </button>

        <button
          type="button"
          id="btnAudienceClinic"
          class="audience-toggle-btn"
          data-audience="clinic"
          role="tab"
          aria-selected="false"
        >
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M3 21h18"></path><path d="M9 8h1"></path><path d="M9 12h1"></path><path d="M9 16h1"></path><path d="M14 8h1"></path><path d="M14 12h1"></path><path d="M14 16h1"></path><path d="M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16"></path></svg>
          <span>Clínica com Equipe</span>
        </button>

        <button
          type="button"
          id="btnAudienceEnterprise"
          class="audience-toggle-btn"
          data-audience="enterprise"
          role="tab"
          aria-selected="false"
        >
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
          <span>Enterprise</span>
        </button>
      </div>

      <!-- Ciclos de Cobrança Otimizados: 3 opções compactas que cabem perfeitamente no mobile -->
      <div
        role="group"
        aria-label="Ciclo de cobrança"
        class="cycles-switcher"
        id="cyclesSwitcherGroup"
      >
        {BILLING_CYCLES.map((c) => (
          <button
            type="button"
            data-cycle={c.id}
            class={`cycle-btn ${c.id === 'mensal' ? 'active' : ''}`}
          >
            <span>{c.label}</span>
            {c.note ? <span class="cycle-note">{c.note}</span> : null}
          </button>
        ))}
      </div>
    </div>

    <!-- Grupo 1: Planos Profissional (Ativo por Padrão) -->
    <div class="plans-list audience-group" id="plansGroupProf">
      {PROF_PLANS.map((plan) => (
        <PlanCard plan={plan} />
      ))}
    </div>

    <!-- Grupo 2: Planos Clínica (Alternável) -->
    <div class="plans-list audience-group" id="plansGroupClinic" style="display: none;">
      {CLINIC_PLANS.map((plan) => (
        <PlanCard plan={plan} />
      ))}
    </div>

    <!-- Grupo 3: Solução Enterprise Completa e Imponente (3ª Aba) -->
    <div class="enterprise-pane audience-group" id="plansGroupEnterprise" style="display: none;">
      <div class="enterprise-hero-card">
        <div class="enterprise-badge-highlight">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
          <span>Grandes Redes e Hospitais</span>
        </div>
        <h3 class="enterprise-heading">Soluções Corporativas Sob Medida</h3>
        <p class="enterprise-lead">
          Para hospitais, franquias, centros universitários e redes de reabilitação física com mais de 30 profissionais que precisam de governança avançada, banco de dados isolado e suporte 24/7.
        </p>

        <div class="enterprise-features-grid">
          <div class="enterprise-feature-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <div>
              <strong>Migração Assistida VIP</strong>
              <p>Nossos engenheiros importam todo o seu banco de dados de prontuários antigos sem risco de perda.</p>
            </div>
          </div>

          <div class="enterprise-feature-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <div>
              <strong>Múltiplas Unidades e Filiais</strong>
              <p>Controle centralizado com permissões hierárquicas por unidade, gestor e profissional.</p>
            </div>
          </div>

          <div class="enterprise-feature-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <div>
              <strong>SLA Dedicado & Gerente de Contas</strong>
              <p>Canal direto com time de desenvolvimento e treinamento presencial ou remoto para toda a equipe.</p>
            </div>
          </div>

          <div class="enterprise-feature-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <div>
              <strong>Integrações Customizadas</strong>
              <p>Conexão via API com ERPs hospitalares, sistemas de faturamento TISS/TUSS e biometria.</p>
            </div>
          </div>
        </div>

        <div class="enterprise-cta-block">
          <a
            href="https://wa.me/5511999999999?text=Ol%C3%A1%2C%20gostaria%20de%20conversar%20sobre%20o%20Plano%20Enterprise%20do%20Pluri%20Fisio"
            target="_blank"
            rel="noopener"
            class="enterprise-primary-btn"
          >
            <span>Falar com Consultor Corporativo</span>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </a>
        </div>
      </div>
    </div>

    <!-- Rodapé Sutil e Informativo (Sem cobrir cards) -->
    <div class="plans-footer-info">
      <span>💡 Pagamento no PIX com 5% de desconto · Ativação imediata da conta</span>
    </div>
  </div>
</section>

<style>
  .plans-section {
    position: relative;
    width: 100%;
    min-height: auto;
    background-color: var(--background);
    padding: clamp(3.5rem, 6vw, 6rem) clamp(1rem, 3.5vw, 3rem);
    box-sizing: border-box;
    overflow: hidden;
  }

  .plans-container {
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(1.8rem, 3.5vw, 2.5rem);
    box-sizing: border-box;
  }

  .plans-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    text-align: center;
    max-width: 820px;
    margin: 0 auto;
  }

  .plans-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.3rem 0.85rem;
    border-radius: 9999px;
    background: #EFF6FF;
    border: 1px solid #BFDBFE;
    color: #0072FF;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .plans-main-heading {
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #0F172A;
    line-height: 1.2;
    margin: 0;
  }

  /* Banner de Confiança CRO: 7 Dias Grátis */
  .free-trial-banner {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    background: #F0FDF4;
    border: 1px solid #BBF7D0;
    color: #166534;
    padding: 0.45rem 1.1rem;
    border-radius: 9999px;
    font-size: clamp(0.78rem, 1vw, 0.86rem);
    box-shadow: 0 2px 8px rgba(22, 101, 52, 0.06);
  }

  .free-trial-banner svg {
    color: #16A34A;
    flex-shrink: 0;
  }

  /* Seletor Master: 3 Abas Profissional / Clínica / Enterprise */
  .audience-toggle-wrapper {
    display: flex;
    gap: 0.35rem;
    background: #F1F5F9;
    padding: 0.35rem;
    border-radius: 9999px;
    border: 1px solid #E2E8F0;
    margin-top: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .audience-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 1.2rem;
    border-radius: 9999px;
    border: none;
    background: transparent;
    color: #64748B;
    font-size: clamp(0.8rem, 1.1vw, 0.88rem);
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .audience-toggle-btn:hover {
    color: #0F172A;
  }

  .audience-toggle-btn.active {
    background: #FFFFFF;
    color: #0072FF;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.08);
  }

  /* Seletor de Frequência Compacto (3 Opções) */
  .cycles-switcher {
    display: flex;
    justify-content: center;
    gap: 0.35rem;
    border-radius: 999px;
    background-color: #F1F5F9;
    border: 1px solid #E2E8F0;
    padding: 0.25rem;
    margin-top: 0.25rem;
  }

  .cycle-btn {
    min-height: 2.3rem;
    border-radius: 999px;
    padding-inline: clamp(0.85rem, 1.8vw, 1.35rem);
    font-size: clamp(0.78rem, 1vw, 0.85rem);
    font-weight: 700;
    color: #64748B;
    background: transparent;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    white-space: nowrap;
  }

  .cycle-btn:hover {
    color: #0F172A;
  }

  .cycle-btn.active {
    background-color: #0F172A;
    color: #FFFFFF;
  }

  .cycle-note {
    font-size: 0.74rem;
    color: #0072FF;
    font-weight: 800;
  }

  .cycle-btn.active .cycle-note {
    color: #38BDF8;
  }

  /* Grid dos Planos: Organização e Respiro no Desktop */
  .plans-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(1.2rem, 2.5vw, 2rem);
    width: 100%;
    box-sizing: border-box;
  }

  /* Aba Enterprise */
  .enterprise-hero-card {
    background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%);
    border-radius: 24px;
    padding: clamp(2rem, 4vw, 3.5rem);
    color: #FFFFFF;
    box-shadow: 0 16px 40px rgba(15, 23, 42, 0.15);
  }

  .enterprise-badge-highlight {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: rgba(0, 198, 255, 0.15);
    border: 1px solid rgba(0, 198, 255, 0.35);
    color: #38BDF8;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 800;
    margin-bottom: 1.25rem;
  }

  .enterprise-heading {
    font-size: clamp(1.6rem, 2.8vw, 2.4rem);
    font-weight: 800;
    margin: 0 0 0.85rem 0;
    line-height: 1.2;
  }

  .enterprise-lead {
    font-size: clamp(0.95rem, 1.4vw, 1.15rem);
    color: #94A3B8;
    line-height: 1.55;
    max-width: 820px;
    margin: 0 0 2rem 0;
  }

  .enterprise-features-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem;
    margin-bottom: 2.5rem;
  }

  .enterprise-feature-item {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .enterprise-feature-item svg {
    color: #38BDF8;
    flex-shrink: 0;
    margin-top: 3px;
  }

  .enterprise-feature-item strong {
    display: block;
    font-size: 1rem;
    color: #FFFFFF;
    margin-bottom: 0.25rem;
  }

  .enterprise-feature-item p {
    font-size: 0.86rem;
    color: #94A3B8;
    line-height: 1.45;
    margin: 0;
  }

  .enterprise-cta-block {
    display: flex;
    justify-content: flex-start;
  }

  .enterprise-primary-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    background: linear-gradient(135deg, #0072FF, #00C6FF);
    color: #FFFFFF;
    padding: 0.95rem 2rem;
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 800;
    text-decoration: none;
    box-shadow: 0 8px 24px rgba(0, 114, 255, 0.3);
    transition: all 0.2s ease;
  }

  .enterprise-primary-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(0, 114, 255, 0.4);
  }

  .plans-footer-info {
    text-align: center;
    font-size: 0.82rem;
    color: #64748B;
    margin-top: 0.5rem;
  }

  /* Responsivo Mobile & Tablets (Scroll Natural sem compressão) */
  @media (max-width: 860px) {
    .plans-section {
      padding: 3rem 1.25rem;
    }

    .plans-main-heading {
      font-size: 1.65rem;
    }

    .free-trial-banner {
      font-size: 0.78rem;
      border-radius: 12px;
      text-align: left;
    }

    .audience-toggle-wrapper {
      width: 100%;
    }

    .audience-toggle-btn {
      flex: 1;
      justify-content: center;
      padding: 0.5rem 0.75rem;
      font-size: 0.78rem;
    }

    .cycles-switcher {
      width: 100%;
    }

    .cycle-btn {
      flex: 1;
      justify-content: center;
      padding-inline: 0.5rem;
      font-size: 0.76rem;
    }

    /* Cards no Mobile: carrossel horizontal fluído ou empilhamento confortável */
    .plans-list {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      touch-action: pan-x pan-y;
      scrollbar-width: none;
      gap: 1rem;
      padding-bottom: 0.75rem;
    }

    .plans-list::-webkit-scrollbar {
      display: none;
    }

    :global(.plan-card) {
      min-width: 86vw !important;
      max-width: 86vw !important;
      scroll-snap-align: center !important;
      flex-shrink: 0 !important;
    }

    .enterprise-features-grid {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }

    .enterprise-primary-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
