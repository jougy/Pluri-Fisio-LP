---
// PricingSection.astro - Seção 4: Planos (Refatorado & Modular)
import { BILLING_CYCLES, PROF_PLANS, CLINIC_PLANS } from '../../data/pricing-plans';
import PlanCard from '../pricing/PlanCard.astro';
---

<section
  id="planos"
  aria-labelledby="planos-titulo"
  class="snap-page plans-section"
>
  <div class="plans-header">
    <div class="plans-badge">
      <span>TRANSPARÊNCIA TOTAL</span>
    </div>
    
    <h2 id="planos-titulo" class="t-title plans-main-heading">
      Planos que cabem no momento do seu trabalho.
    </h2>

    <!-- Seletor de Perfil: Profissional x Clínica -->
    <div class="audience-toggle-wrapper" role="tablist" aria-label="Seletor de Perfil">
      <button
        type="button"
        id="btnAudienceProf"
        class="audience-toggle-btn active"
        data-audience="prof"
        role="tab"
        aria-selected="true"
      >
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        <span>Para Profissional</span>
      </button>

      <button
        type="button"
        id="btnAudienceClinic"
        class="audience-toggle-btn"
        data-audience="clinic"
        role="tab"
        aria-selected="false"
      >
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M3 21h18"></path><path d="M9 8h1"></path><path d="M9 12h1"></path><path d="M9 16h1"></path><path d="M14 8h1"></path><path d="M14 12h1"></path><path d="M14 16h1"></path><path d="M5 21V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v16"></path></svg>
        <span>Para Clínica</span>
      </button>
    </div>

    <!-- Ciclos de Cobrança -->
    <div
      role="group"
      aria-label="Ciclo de cobrança"
      class="cycles-switcher"
    >
      {BILLING_CYCLES.map((c) => (
        <button
          type="button"
          data-cycle={c.id}
          class={`t-small cycle-btn ${c.id === 'mensal' ? 'active' : ''}`}
        >
          {c.label}
          {c.note ? <span class="cycle-note">{c.note}</span> : null}
        </button>
      ))}
    </div>
  </div>

  <!-- Grupo 1: Planos Profissional (Ativo por Padrão) -->
  <div class="plans-list audience-group" id="plansGroupProf">
    {PROF_PLANS.map((plan) => (
      <PlanCard plan={plan} />
    ))}
  </div>

  <!-- Grupo 2: Planos Clínica (Alternável) -->
  <div class="plans-list audience-group" id="plansGroupClinic" style="display: none;">
    {CLINIC_PLANS.map((plan) => (
      <PlanCard plan={plan} />
    ))}
  </div>

  <!-- Card / Banner Enterprise: Vamos Conversar -->
  <div class="enterprise-banner">
    <div class="enterprise-content">
      <div class="enterprise-badge">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
        <span>PLANO ENTERPRISE</span>
      </div>
      <div class="enterprise-text">
        <h4 class="enterprise-title">Redes de clínicas ou hospitais? Vamos conversar.</h4>
        <p class="enterprise-desc">Múltiplas unidades integradas, migração dedicada de servidores antigos, SLAs personalizados e governança avançada.</p>
      </div>
    </div>
    <div class="enterprise-action">
      <a
        href="https://wa.me/5511999999999?text=Ol%C3%A1%2C%20gostaria%20de%20conversar%20sobre%20o%20Plano%20Enterprise%20do%20Pluri%20Fisio"
        target="_blank"
        rel="noopener"
        class="enterprise-cta-btn"
      >
        <span>Vamos conversar</span>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </a>
    </div>
  </div>

  <p class="t-small plans-footer-note">
    <span class="mobile-only">Deslize para ver todos os planos · </span>Pagamento no PIX com 5% de desconto · Cancele quando quiser · Pluri Fisio
  </p>
</section>

<style>
  .plans-section {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(0.5rem, 1.4vmin, 1.2rem);
    background-color: var(--background);
    padding-inline: clamp(1rem, 3.5vmin, 3rem);
    padding-bottom: clamp(0.75rem, 1.8vmin, 1.5rem);
    padding-top: calc(3.5rem + clamp(0.5rem, 1.5vmin, 1.2rem));
    position: relative;
    width: 100vw;
    height: 100svh;
    min-height: 100svh;
    max-height: 100svh;
    overflow-y: auto;
    box-sizing: border-box;
  }

  .plans-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(0.35rem, 0.9vmin, 0.75rem);
    text-align: center;
    flex-shrink: 0;
  }

  .plans-badge {
    display: inline-flex;
    align-items: center;
    padding: clamp(0.2rem, 0.6vmin, 0.35rem) clamp(0.6rem, 1.4vmin, 0.85rem);
    border-radius: 9999px;
    background: #EFF6FF;
    border: 1px solid #BFDBFE;
    color: #0072FF;
    font-size: clamp(0.65rem, 1vmin, 0.74rem);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .plans-main-heading {
    font-size: clamp(1.25rem, 2.2vmin, 1.95rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #0F172A;
    line-height: 1.2;
    margin: 0;
  }

  /* Seletor de Perfil (Profissional x Clínica) */
  .audience-toggle-wrapper {
    display: flex;
    gap: 0.35rem;
    background: #F1F5F9;
    padding: 0.25rem;
    border-radius: 9999px;
    border: 1px solid #E2E8F0;
  }

  .audience-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: clamp(0.35rem, 0.9vmin, 0.5rem) clamp(0.85rem, 1.6vmin, 1.2rem);
    border-radius: 9999px;
    border: none;
    background: transparent;
    color: #64748B;
    font-size: clamp(0.76rem, 1.1vmin, 0.85rem);
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .audience-toggle-btn:hover {
    color: #0F172A;
  }

  .audience-toggle-btn.active {
    background: #FFFFFF;
    color: #0072FF;
    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.08);
  }

  .cycles-switcher {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem;
    border-radius: 999px;
    background-color: var(--sand);
    padding: 0.2rem;
  }

  .cycle-btn {
    min-height: clamp(2rem, 3vmin, 2.3rem);
    border-radius: 999px;
    padding-inline: clamp(0.7rem, 1.4vmin, 1rem);
    font-size: clamp(0.74rem, 1.1vmin, 0.82rem);
    font-weight: 600;
    color: var(--muted-foreground);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }

  .cycle-btn:hover {
    color: var(--foreground);
  }

  .cycle-btn.active {
    background-color: var(--ink);
    color: var(--bone);
  }

  .cycle-note {
    margin-left: 0.35rem;
    color: var(--clay);
  }

  .cycle-btn.active .cycle-note {
    color: var(--sage);
  }

  .plans-list {
    margin-inline: auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    width: 100%;
    max-width: 1280px;
    min-height: 0;
    flex: 1;
    gap: clamp(0.75rem, 1.6vmin, 1.4rem);
    box-sizing: border-box;
  }

  /* Enterprise Banner */
  .enterprise-banner {
    width: 100%;
    max-width: 1280px;
    margin: 0 auto;
    background: #FFFFFF;
    border: 1px dashed #CBD5E1;
    border-radius: 12px;
    padding: clamp(0.5rem, 1vmin, 0.75rem) clamp(0.85rem, 1.5vmin, 1.25rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-shrink: 0;
    box-sizing: border-box;
  }

  .enterprise-content {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }

  .enterprise-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: #F1F5F9;
    color: #334155;
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    white-space: nowrap;
  }

  .enterprise-title {
    font-size: clamp(0.8rem, 1.1vmin, 0.88rem);
    font-weight: 700;
    color: #0F172A;
    margin: 0 0 0.1rem 0;
  }

  .enterprise-desc {
    font-size: clamp(0.7rem, 0.95vmin, 0.75rem);
    color: #64748B;
    line-height: 1.35;
    margin: 0;
  }

  .enterprise-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: #0F172A;
    color: #FFFFFF;
    font-size: clamp(0.74rem, 1.1vmin, 0.8rem);
    font-weight: 700;
    padding: 0.45rem 1rem;
    border-radius: 8px;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s ease;
  }

  .enterprise-cta-btn:hover {
    background: #0072FF;
  }

  .plans-footer-note {
    text-align: center;
    font-size: clamp(0.68rem, 0.9vmin, 0.75rem);
    color: var(--muted-foreground);
    margin: 0;
    flex-shrink: 0;
  }

  .mobile-only {
    display: none;
  }

  /* Responsivo Mobile & Tablets com Scroll Snap Horizontal nos Planos */
  @media (max-width: 960px) {
    .plans-list {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding-bottom: 0.5rem;
    }

    .plans-list::-webkit-scrollbar {
      display: none;
    }

    :global(.plan-card) {
      min-width: 82vw !important;
      max-width: 82vw !important;
      scroll-snap-align: center !important;
      flex-shrink: 0 !important;
    }

    .mobile-only {
      display: inline;
    }

    .enterprise-banner {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.65rem;
    }

    .enterprise-action {
      width: 100%;
    }

    .enterprise-cta-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
