---
// WorkflowSection.astro - Seção 3: Seis etapas. Nenhuma fricção (Scroll Natural & Zero Setas Invasivas)
import { WORKFLOW_STEPS } from '../../data/workflow-steps';
import WorkflowCard from '../workflow/WorkflowCard.astro';

// Dividir as etapas em 2 slides de 3 cards para o carrossel responsivo
const slide1 = WORKFLOW_STEPS.slice(0, 3);
const slide2 = WORKFLOW_STEPS.slice(3, 6);
---

<section
  id="como-funciona"
  aria-labelledby="como-titulo"
  class="snap-page workflow-navy-section"
>
  <!-- Efeito sutil no fundo com luzes orgânicas difusas (azul, ciano e violeta) -->
  <div class="workflow-ambient-bg" aria-hidden="true">
    <div class="ambient-glow glow-cyan"></div>
    <div class="ambient-glow glow-indigo"></div>
    <div class="ambient-glow glow-purple"></div>
  </div>

  <div class="workflow-navy-container">
    <!-- Header com Título -->
    <div class="workflow-navy-header">
      <div>
        <h2 id="como-titulo" class="workflow-navy-title">
          Principais Funcionalidades
        </h2>
      </div>
    </div>

    <!-- Wrapper do Carrossel Dinâmico / Grid -->
    <div class="workflow-carousel-viewport" id="workflowCarouselViewport">
      <!-- Trilho de Cards Organizados por Slides Dinâmicos -->
      <div class="workflow-cards-track" id="workflowCardsTrack">
        <!-- Slide 1 (Cards 01 a 03) -->
        <div class="workflow-carousel-slide" data-slide-index="0">
          {slide1.map(item => (
            <WorkflowCard stepData={item} />
          ))}
        </div>

        <!-- Slide 2 (Cards 04 a 06) -->
        <div class="workflow-carousel-slide" data-slide-index="1">
          {slide2.map(item => (
            <WorkflowCard stepData={item} />
          ))}
        </div>
      </div>
    </div>

    <!-- Indicador Dinâmico / Controles Móveis (Bolinhas limpas sem setas invasivas) -->
    <div class="workflow-carousel-pagination" id="workflowPagination">
      <div class="carousel-dots-list" id="workflowDotsList">
        <button type="button" class="carousel-dot active" aria-label="Ver etapas 1 a 3" data-slide-to="0"></button>
        <button type="button" class="carousel-dot" aria-label="Ver etapas 4 a 6" data-slide-to="1"></button>
      </div>
      <span class="swipe-hint-text">👉 Deslize para o lado para ver as etapas 4 a 6</span>
    </div>

  </div>
</section>

<style>
  .workflow-navy-section {
    position: relative;
    width: 100%;
    min-height: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(180deg, #091730 0%, #0E2246 50%, #08152B 100%) !important;
    color: #FFFFFF !important;
    padding: clamp(3.5rem, 6vw, 6rem) clamp(1.25rem, 4vw, 3.5rem);
    box-sizing: border-box;
    overflow: hidden;
  }

  /* Fundo sutil e elegante com luzes difusas acolhedoras */
  .workflow-ambient-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
  }

  .ambient-glow {
    position: absolute;
    border-radius: 9999px;
    filter: blur(100px);
    opacity: 0.28;
    pointer-events: none;
    will-change: transform;
  }

  .glow-cyan {
    top: -10%;
    left: 15%;
    width: clamp(300px, 35vw, 550px);
    height: clamp(300px, 35vw, 550px);
    background: radial-gradient(circle, #00E5FF 0%, rgba(0, 229, 255, 0.2) 60%, transparent 80%);
  }

  .glow-indigo {
    bottom: -15%;
    right: 10%;
    width: clamp(320px, 40vw, 600px);
    height: clamp(320px, 40vw, 600px);
    background: radial-gradient(circle, #6366F1 0%, rgba(99, 102, 241, 0.2) 60%, transparent 80%);
  }

  .glow-purple {
    top: 35%;
    right: 35%;
    width: clamp(280px, 30vw, 480px);
    height: clamp(280px, 30vw, 480px);
    background: radial-gradient(circle, #A855F7 0%, rgba(168, 85, 247, 0.15) 60%, transparent 80%);
    opacity: 0.18;
  }

  .workflow-navy-container {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    box-sizing: border-box;
  }

  /* Header com Título e Botão Lateral */
  .workflow-navy-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    width: 100%;
    flex-shrink: 0;
  }

  .workflow-tag-pill {
    display: inline-block;
    color: #38BDF8;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.4rem;
  }

  .workflow-navy-title {
    font-size: clamp(1.8rem, 3.4vw, 2.8rem) !important;
    font-weight: 800 !important;
    letter-spacing: -0.03em !important;
    line-height: 1.15 !important;
    color: #FFFFFF !important;
    margin: 0 !important;
  }

  /* Viewport do Carrossel */
  .workflow-carousel-viewport {
    position: relative;
    width: 100%;
    min-height: 0;
  }

  /* Trilho de Cards: Grid 3x2 no Desktop com align-items: start para expansão independente */
  .workflow-cards-track {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: start;
    gap: clamp(1rem, 2vw, 1.8rem);
    box-sizing: border-box;
  }

  .workflow-carousel-slide {
    display: contents;
  }

  /* Paginação / Bolinhas */
  .workflow-carousel-pagination {
    display: none;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 0.5rem;
    flex-shrink: 0;
    margin-top: 0.5rem;
  }

  .carousel-dots-list {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .carousel-dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.25);
    border: none;
    padding: 0;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .carousel-dot.active {
    width: 28px;
    background: #38BDF8 !important;
  }

  .swipe-hint-text {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.65) !important;
    font-weight: 500;
  }

  /* Mobile e Telas Compactas: Scroll Horizontal Nativo Limpo e Sem Setas */
  @media (max-width: 860px) {
    .workflow-navy-section {
      padding: 3rem 1.25rem;
    }

    .workflow-navy-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .hide-mobile {
      display: none;
    }

    .workflow-navy-title {
      font-size: 1.7rem !important;
    }

    .workflow-header-hint {
      width: 100%;
      justify-content: center;
      font-size: 0.8rem;
      padding: 0.5rem 0.75rem;
      box-sizing: border-box;
    }

    .workflow-cards-track {
      display: flex !important;
      grid-template-columns: none !important;
      overflow-x: auto !important;
      scroll-snap-type: x mandatory !important;
      -webkit-overflow-scrolling: touch;
      touch-action: pan-x pan-y !important;
      scrollbar-width: none !important;
      gap: 1rem !important;
      padding: 0.25rem 0 !important;
      width: 100% !important;
    }

    .workflow-cards-track::-webkit-scrollbar {
      display: none !important;
    }

    .workflow-carousel-slide {
      display: flex !important;
      flex-direction: column !important;
      gap: 0.85rem !important;
      min-width: 100% !important;
      max-width: 100% !important;
      flex-shrink: 0 !important;
      scroll-snap-align: center !important;
      box-sizing: border-box !important;
    }

    .workflow-carousel-pagination {
      display: flex !important;
    }
  }
</style>
