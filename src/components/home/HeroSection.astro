---
// HeroSection.astro - Seção 1: Hero Limpo, Centralizado e Elegante (Identidade Visual Pluri Fisio)
---

<section
  id="lancamento"
  aria-labelledby="lancamento-titulo"
  class="snap-page clinical-hero-section"
>
  <!-- Background com o gradiente suave característico da marca -->
  <div class="hero-bg-branding" aria-hidden="true">
    <div class="radial-glow glow-top"></div>
    <div class="radial-glow glow-bottom"></div>
  </div>

  <div class="hero-container-centered">
    <!-- Brand Header: Logo Grande + Título Pluri Fisio (sem pílula/cápsula ao redor) -->
    <div class="hero-brand-header">
      <img
        src="/branding/logo/pluri_health_icon_gradient.svg"
        alt="Pluri Fisio Icon"
        class="hero-brand-icon"
        width="80"
        height="80"
      />
      <div class="hero-brand-name-group">
        <span class="hero-brand-name">Pluri Fisio</span>
      </div>
    </div>

    <!-- Frase Principal Solicitada (Título de Alto Impacto) -->
    <h1 id="lancamento-titulo" class="hero-clean-title">
      Solução simples, rápida e prática para seu dia-a-dia de atendimentos.
    </h1>

    <!-- Complemento Imediato -->
    <p class="hero-clean-subtitle">
      Para profissionais e clínicas da área de fisioterapia.
    </p>

    <!-- CTAs Limpos e Diretos -->
    <div class="hero-clean-cta-group">
      <a href="#planos" class="btn-hero-clean-primary">
        <span>Começar agora</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
      <a href="#plataforma" class="btn-hero-clean-secondary">
        <span>Conhecer a plataforma</span>
      </a>
    </div>

    <!-- Micro Selo de Confiança Discreto (sem menção a cartão) -->
    <div class="hero-clean-trust">
      <span>20 atendimentos grátis</span>
      <span class="trust-bullet">•</span>
      <span>Migração gratuita de fichas</span>
      <span class="trust-bullet">•</span>
      <span>100% LGPD</span>
    </div>
  </div>
</section>

<style>
  .clinical-hero-section {
    position: relative;
    width: 100%;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #FFFFFF;
    overflow: hidden;
    padding: clamp(2rem, 5vh, 4rem) 1.5rem;
  }

  /* Fundo com atmosfera de marca (azul celeste bem suave inspirado nos posts) */
  .hero-bg-branding {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
  }

  .radial-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.65;
  }

  .glow-top {
    top: -15%;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 450px;
    background: radial-gradient(circle, rgba(0, 242, 254, 0.18) 0%, rgba(0, 114, 255, 0.08) 60%, transparent 100%);
  }

  .glow-bottom {
    bottom: -10%;
    right: 15%;
    width: 500px;
    height: 350px;
    background: radial-gradient(circle, rgba(0, 198, 255, 0.12) 0%, transparent 70%);
  }

  /* Container Centralizado */
  .hero-container-centered {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 820px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1rem 0;
  }

  /* Logo e Nome da Marca (Livre, sem pílula, maior e em destaque) */
  .hero-brand-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 2rem;
  }

  .hero-brand-icon {
    width: clamp(68px, 9vw, 88px);
    height: clamp(68px, 9vw, 88px);
    object-fit: contain;
    filter: drop-shadow(0 8px 24px rgba(0, 114, 255, 0.22));
    transition: transform 0.3s ease;
  }

  .hero-brand-icon:hover {
    transform: scale(1.05);
  }

  .hero-brand-name-group {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .hero-brand-name {
    font-size: clamp(1.25rem, 1.8vw, 1.55rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: #0F172A;
  }

  .hero-product-pill {
    font-size: 0.78rem;
    font-weight: 700;
    color: #0072FF;
    background: #EFF6FF;
    border: 1px solid #BFDBFE;
    padding: 0.25rem 0.7rem;
    border-radius: 9999px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* Título Solicitado */
  .hero-clean-title {
    font-size: clamp(2rem, 4.2vw, 3.4rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.15;
    color: #0F172A;
    margin-bottom: 1.25rem;
    max-width: 760px;
  }

  /* Subtítulo Solicitado */
  .hero-clean-subtitle {
    font-size: clamp(1.05rem, 1.6vw, 1.35rem);
    font-weight: 500;
    color: #475569;
    line-height: 1.5;
    margin-bottom: 2.25rem;
    max-width: 620px;
  }

  /* Ações (CTAs) */
  .hero-clean-cta-group {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .btn-hero-clean-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: linear-gradient(135deg, #0072FF 0%, #0052D4 100%);
    color: #FFFFFF;
    font-size: 0.95rem;
    font-weight: 700;
    padding: 0.85rem 1.85rem;
    border-radius: 9999px;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(0, 114, 255, 0.35);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .btn-hero-clean-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 22px rgba(0, 114, 255, 0.45);
  }

  .btn-hero-clean-secondary {
    display: inline-flex;
    align-items: center;
    background: #FFFFFF;
    color: #334155;
    font-size: 0.95rem;
    font-weight: 600;
    padding: 0.85rem 1.75rem;
    border-radius: 9999px;
    text-decoration: none;
    border: 1px solid #CBD5E1;
    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.04);
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .btn-hero-clean-secondary:hover {
    background: #F8FAFC;
    border-color: #94A3B8;
    color: #0F172A;
  }

  /* Micro Selo de Confiança */
  .hero-clean-trust {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 600;
    color: #64748B;
  }

  .trust-bullet {
    color: #CBD5E1;
  }

  /* Mobile */
  @media (max-width: 640px) {
    .hero-brand-header {
      margin-bottom: 1.5rem;
    }

    .hero-clean-title {
      font-size: 1.85rem;
      line-height: 1.2;
    }

    .hero-clean-subtitle {
      font-size: 1rem;
      margin-bottom: 1.75rem;
    }

    .hero-clean-cta-group {
      width: 100%;
      flex-direction: column;
      gap: 0.65rem;
    }

    .btn-hero-clean-primary,
    .btn-hero-clean-secondary {
      width: 100%;
      justify-content: center;
    }

    .hero-clean-trust {
      font-size: 0.72rem;
      flex-wrap: wrap;
      justify-content: center;
    }
  }
</style>
