---
// HeroSection.astro - Seção 1: Lançamento Pluri Fisio com Orbitas e Grid Suave
---

<section
  id="lancamento"
  aria-labelledby="lancamento-titulo"
  class="snap-page hero-aurora hero-section"
>
  <div aria-hidden="true" class="hero-grid"></div>
  <div aria-hidden="true" class="hero-orbit orbit-1"></div>
  <div aria-hidden="true" class="hero-orbit orbit-2"></div>
  
  <div class="hero-brand-top">
    <span class="t-small hero-badge" aria-label="Lançamento Oficial">
      <span class="wave-word">
        <span class="wave-char" style="--i: 0;">L</span>
        <span class="wave-char" style="--i: 1;">a</span>
        <span class="wave-char" style="--i: 2;">n</span>
        <span class="wave-char" style="--i: 3;">ç</span>
        <span class="wave-char" style="--i: 4;">a</span>
        <span class="wave-char" style="--i: 5;">m</span>
        <span class="wave-char" style="--i: 6;">e</span>
        <span class="wave-char" style="--i: 7;">n</span>
        <span class="wave-char" style="--i: 8;">t</span>
        <span class="wave-char" style="--i: 9;">o</span>
      </span>
      <span class="wave-word">
        <span class="wave-char" style="--i: 10;">O</span>
        <span class="wave-char" style="--i: 11;">f</span>
        <span class="wave-char" style="--i: 12;">i</span>
        <span class="wave-char" style="--i: 13;">c</span>
        <span class="wave-char" style="--i: 14;">i</span>
        <span class="wave-char" style="--i: 15;">a</span>
        <span class="wave-char" style="--i: 16;">l</span>
      </span>
    </span>

    <div class="hero-brand-identity">
      <img
        src="/branding/logo/pluri_health_icon_gradient.svg"
        alt="Pluri Fisio"
        class="hero-logo-mark"
        width="110"
        height="110"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <h1 class="hero-brand-name neon-glow-heading" aria-label="Pluri Fisio">
        Pluri Fisio
      </h1>
    </div>

    <span class="hero-target-audience">Para fisioterapeutas e clínicas</span>
  </div>

  <p id="lancamento-titulo" class="hero-title">
    Solução simples, rápida e prática para seu dia-a-dia de atendimentos.
  </p>

  <div class="hero-actions">
    <a href="#planos" class="btn-clay hero-btn">
      Começar grátis 
      <svg aria-hidden="true" class="icon-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="5" y1="12" x2="19" y2="12"></line>
        <polyline points="12 5 19 12 12 19"></polyline>
      </svg>
    </a>
    <a href="#plataforma" class="btn-ink hero-btn">
      Saiba mais
    </a>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    width: 100%;
    min-height: calc(100vh - 2rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(1rem, 2.5vmin, 1.8rem);
    padding-inline: max(1.5rem, 6vmin);
    padding-top: 5rem;
    padding-bottom: 3.5rem;
    text-align: center;
  }

  .hero-brand-top {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    position: relative;
    z-index: 2;
  }

  .hero-brand-identity {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(0.75rem, 1.8vmin, 1.25rem);
    margin-top: 0.25rem;
    margin-bottom: 0.25rem;
  }

  .hero-logo-mark {
    width: clamp(96px, 15vmin, 140px);
    height: auto;
    display: block;
    filter: drop-shadow(0 10px 24px rgba(0, 114, 255, 0.35));
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-logo-mark:hover {
    transform: scale(1.06);
  }

  /* Título Pluri Fisio: apenas GLOW NEON estático e limpo sem onda */
  .hero-brand-name {
    font-size: clamp(2.8rem, 6.2vmin, 4.5rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 1.25;
    margin: 0;
    padding: 0.35rem clamp(0.75rem, 2vw, 1.5rem);
    color: #0072FF;
    text-shadow:
      0 0 8px rgba(0, 114, 255, 0.5),
      0 0 20px rgba(0, 198, 255, 0.4),
      0 0 40px rgba(0, 114, 255, 0.25);
    display: block;
    user-select: none;
  }

  /* Badge Lançamento Oficial: agora com o efeito WAVY suave */
  .hero-badge {
    font-size: clamp(0.8rem, 1.6vmin, 1rem);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.24em;
    color: var(--clay);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35em;
  }

  .wave-word {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }

  .wave-char {
    display: inline-block;
    animation: badgeCharWave 2.2s cubic-bezier(0.45, 0, 0.55, 1) infinite;
    animation-delay: calc(var(--i) * 0.08s);
    will-change: transform;
    transform: translate3d(0, 0, 0);
    backface-visibility: hidden;
  }

  @keyframes badgeCharWave {
    0%, 100% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(0, -5px, 0);
      color: #00C6FF;
    }
  }

  .hero-target-audience {
    font-size: clamp(0.85rem, 1.6vmin, 1rem);
    font-weight: 600;
    color: var(--clay);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(to right, rgba(0, 0, 0, 0.035) 1px, transparent 1px),
                      linear-gradient(to bottom, rgba(0, 0, 0, 0.035) 1px, transparent 1px);
    background-size: 4rem 4rem;
    mask-image: radial-gradient(circle at center, black 40%, transparent 80%);
    -webkit-mask-image: radial-gradient(circle at center, black 40%, transparent 80%);
    pointer-events: none;
    z-index: 0;
  }

  .hero-orbit {
    position: absolute;
    border-radius: 9999px;
    border: 1px solid rgba(0, 114, 255, 0.12);
    pointer-events: none;
    z-index: 0;
    animation: orbitRotate 30s linear infinite;
  }

  .orbit-1 {
    left: 50%;
    top: 50%;
    width: min(85vmin, 850px);
    height: min(85vmin, 850px);
    margin-left: max(-42.5vmin, -425px);
    margin-top: max(-42.5vmin, -425px);
  }

  .orbit-2 {
    left: 50%;
    top: 50%;
    width: min(58vmin, 580px);
    height: min(58vmin, 580px);
    margin-left: max(-29vmin, -290px);
    margin-top: max(-29vmin, -290px);
    animation-delay: -6s;
  }

  @keyframes orbitRotate {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }


  .hero-title {
    position: relative;
    z-index: 2;
    font-size: clamp(1.85rem, 4.2vmin, 3.25rem);
    font-weight: 700;
    line-height: 1.18;
    max-width: 22ch;
    color: var(--foreground);
    letter-spacing: -0.025em;
    margin: 0;
  }

  .hero-lead {
    position: relative;
    z-index: 2;
    font-size: clamp(1.05rem, 2.2vmin, 1.35rem);
    font-weight: 500;
    line-height: 1.5;
    max-width: 38ch;
    color: var(--muted-foreground);
    margin: 0;
  }

  .hero-actions {
    position: relative;
    z-index: 2;
    margin-top: clamp(0.4rem, 1vmin, 0.8rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
  }

  .hero-btn {
    min-height: 2.75rem !important;
    padding-inline: clamp(1.25rem, 2.5vmin, 2rem) !important;
    font-size: clamp(0.88rem, 1.6vmin, 1rem) !important;
    font-weight: 700 !important;
    text-decoration: none;
    border-radius: 9999px;
    box-shadow: 0 4px 14px rgba(0, 114, 255, 0.2);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .hero-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 114, 255, 0.3);
  }

  .icon-arrow {
    display: inline-block;
    vertical-align: middle;
  }

  @media (max-width: 640px) {
    .hero-title {
      font-size: 1.85rem;
      line-height: 1.22;
      max-width: 100%;
    }

    .hero-lead {
      font-size: 1rem;
      max-width: 100%;
    }

    .hero-actions {
      width: 100%;
      flex-direction: column;
      gap: 0.75rem;
    }

    .hero-btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
