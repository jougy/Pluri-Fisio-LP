---
// PlatformSection.astro - Seção 2: Experiência 100% Tema Claro, Centralizada, Sem Card/Borda, com Imagens Alternadas
---

<section
  id="plataforma"
  aria-labelledby="plataforma-titulo"
  class="snap-page light-platform-section"
>
  <!-- Fundo sutil, colorido e clean com gradientes suaves em mesh -->
  <div class="clean-colorful-bg" aria-hidden="true">
    <div class="color-blob blob-1"></div>
    <div class="color-blob blob-2"></div>
    <div class="color-blob blob-3"></div>
  </div>

  <!-- Conteúdo Centralizado Aberto: Sem Card, Fundo Vazio e Sem Bordas -->
  <div class="light-platform-content">
    
    <!-- Topo do Texto: Selo + Título H1 -->
    <div class="platform-header-center">
      <div class="light-badge-pill">
        <span class="live-pulse-dot" aria-hidden="true"></span>
        <span>A PLATAFORMA MAIS RÁPIDA</span>
      </div>

      <h1 id="plataforma-titulo" class="light-platform-title">
        O sistema de gestão clínica <strong>mais Facil e Completo</strong> do Brasil
      </h1>

      <!-- Bloco Dinâmico com Título do Carrossel (Sem Parágrafos, Maior e Impactante) -->
      <div class="dynamic-showcase-header" id="dynamicShowcaseHeader">
        <div class="showcase-step-indicator" role="tablist" aria-label="Progresso dos diferenciais">
          <button type="button" class="step-dot active" data-index="0" aria-label="Muito Fácil de Aprender"></button>
          <button type="button" class="step-dot" data-index="1" aria-label="Todos os Dados em um Só Lugar"></button>
          <button type="button" class="step-dot" data-index="2" aria-label="Agendamentos Simplificados"></button>
          <button type="button" class="step-dot" data-index="3" aria-label="Livre de Papéis"></button>
          <button type="button" class="step-dot" data-index="4" aria-label="Estrutura Completa para Gestão de Equipes"></button>
        </div>

        <h2 id="showcaseMainTitle" class="showcase-main-title">
          MUITO FACIL DE APRENDER
        </h2>
      </div>
    </div>

    <!-- Container do Carrossel com Botões de Navegação Direta e Palco Ampliado -->
    <div class="carousel-interactive-wrapper">
      <button 
        type="button" 
        class="carousel-nav-btn prev-btn" 
        id="carouselPrevBtn" 
        aria-label="Item anterior"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <!-- Palco da Ilustração Totalmente Desobstruído, Ampliado e Padronizado -->
      <div class="character-morph-stage" id="characterMorphStage" aria-label="Ilustrações dos diferenciais">
        <!-- 1. Muito Fácil de Aprender -->
        <div class="morph-slide is-active">
          <img
            src="/branding/illustrations/fisio_ref_simple.webp"
            alt="Muito Fácil de Aprender"
            class="morph-character-img"
            data-title="MUITO FACIL DE APRENDER"
            width="640"
            height="640"
            loading="eager"
          />
        </div>
        <!-- 2. Todos os Dados em um Só Lugar -->
        <div class="morph-slide">
          <img
            src="/branding/illustrations/fisio_ref_speed.webp"
            alt="Todos os Dados em um Só Lugar"
            class="morph-character-img"
            data-title="TODOS OS DADOS EM UM SÓ LUGAR"
            width="640"
            height="640"
            loading="lazy"
          />
        </div>
        <!-- 3. Agendamentos Simplificados -->
        <div class="morph-slide">
          <img
            src="/branding/illustrations/fisio_ref_stonks.webp"
            alt="Agendamentos Simplificados"
            class="morph-character-img img-stonks"
            data-title="AGENDAMENTOS SIMPLIFICADOS"
            width="640"
            height="640"
            loading="lazy"
          />
        </div>
        <!-- 4. Livre de Papéis -->
        <div class="morph-slide">
          <img
            src="/branding/illustrations/fisio_ref_nopaper.webp"
            alt="Livre de Papéis"
            class="morph-character-img"
            data-title="LIVRE DE PAPEIS"
            width="640"
            height="640"
            loading="lazy"
          />
        </div>
        <!-- 5. Estrutura Completa para Gestão de Equipes -->
        <div class="morph-slide">
          <img
            src="/branding/illustrations/fisio_ref_organized.webp"
            alt="Estrutura Completa para Gestão de Equipes"
            class="morph-character-img"
            data-title="ESTRUTURA COMPLETA PARA GESTÃO DE EQUIPES"
            width="640"
            height="640"
            loading="lazy"
          />
        </div>
      </div>

      <button 
        type="button" 
        class="carousel-nav-btn next-btn" 
        id="carouselNextBtn" 
        aria-label="Próximo item"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>

  </div>
</section>

<script>
  // Transição sincronizada de carrossel com slide, setas e dots
  function initCharacterMorph() {
    const stage = document.getElementById("characterMorphStage");
    const titleEl = document.getElementById("showcaseMainTitle");
    const dots = document.querySelectorAll<HTMLElement>(".step-dot");
    const prevBtn = document.getElementById("carouselPrevBtn");
    const nextBtn = document.getElementById("carouselNextBtn");
    if (!stage) return;

    const slides = stage.querySelectorAll<HTMLElement>(".morph-slide");
    if (slides.length < 2) return;

    let currentIndex = 0;
    let timer: number | null = null;

    function goToIndex(nextIndex: number, direction: 'next' | 'prev' = 'next') {
      if (nextIndex === currentIndex) return;
      const prevSlide = slides[currentIndex];
      const nextSlide = slides[nextIndex];
      const nextImg = nextSlide.querySelector<HTMLImageElement>(".morph-character-img");

      prevSlide.classList.remove("is-active", "slide-from-left", "slide-from-right");
      prevSlide.classList.add(direction === 'next' ? "slide-to-left" : "slide-to-right");

      setTimeout(() => {
        prevSlide.classList.remove("slide-to-left", "slide-to-right");
      }, 500);

      currentIndex = nextIndex;
      nextSlide.classList.remove("slide-to-left", "slide-to-right");
      nextSlide.classList.add("is-active", direction === 'next' ? "slide-from-right" : "slide-from-left");

      // Atualiza dots indicadores
      dots.forEach((dot, idx) => {
        dot.classList.toggle("active", idx === currentIndex);
      });

      // Transição suave com fade do Título
      if (titleEl && nextImg?.dataset.title) {
        titleEl.style.opacity = "0";
        titleEl.style.transform = "translate3d(0, -6px, 0)";
      }

      setTimeout(() => {
        if (titleEl && nextImg?.dataset.title) {
          titleEl.textContent = nextImg.dataset.title;
          titleEl.style.opacity = "1";
          titleEl.style.transform = "translate3d(0, 0, 0)";
        }
      }, 160);
    }

    function stepNext() {
      const next = (currentIndex + 1) % slides.length;
      goToIndex(next, 'next');
    }

    function stepPrev() {
      const prev = (currentIndex - 1 + slides.length) % slides.length;
      goToIndex(prev, 'prev');
    }

    // Clique nas setas do carrossel
    prevBtn?.addEventListener("click", () => {
      stepPrev();
      stop();
      start();
    });

    nextBtn?.addEventListener("click", () => {
      stepNext();
      stop();
      start();
    });

    // Clique interativo nos dots indicadores
    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        const targetIdx = parseInt(dot.getAttribute("data-index") || "0", 10);
        goToIndex(targetIdx, targetIdx > currentIndex ? 'next' : 'prev');
        stop();
        start();
      });
    });

    // Suporte a Touch Swipe
    let touchStartX = 0;
    let touchEndX = 0;
    stage.addEventListener("touchstart", (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    stage.addEventListener("touchend", (e) => {
      touchEndX = e.changedTouches[0].screenX;
      const diff = touchEndX - touchStartX;
      if (Math.abs(diff) > 40) {
        if (diff < 0) {
          stepNext();
        } else {
          stepPrev();
        }
        stop();
        start();
      }
    }, { passive: true });

    function start() {
      if (!timer) {
        timer = window.setInterval(stepNext, 4600);
      }
    }

    function stop() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    // Pausa suave no hover
    stage.addEventListener("mouseenter", stop);
    stage.addEventListener("mouseleave", start);

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            start();
          } else {
            stop();
          }
        });
      }, { threshold: 0.15 });
      observer.observe(stage);
    } else {
      start();
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCharacterMorph);
  } else {
    initCharacterMorph();
  }
</script>

<style>
  /* Seção em Tema Claro Puro, Aberto e Sem Cartão Escuro */
  .light-platform-section {
    position: relative;
    width: 100%;
    min-height: 100vh;
    min-height: 100svh;
    max-height: 100vh;
    background: #F8FAFC !important;
    color: #0F172A !important;
    padding: calc(3.5rem + 1vh) clamp(1rem, 3.5vw, 3rem) 1.5vh;
    box-sizing: border-box;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    contain: paint;
  }

  /* Fundo Clean, Moderno e Suave com Mesh de Cores */
  .clean-colorful-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
    background: linear-gradient(180deg, #F8FAFC 0%, #EFF6FF 50%, #F8FAFC 100%);
  }

  .color-blob {
    position: absolute;
    border-radius: 9999px;
    filter: blur(80px);
    opacity: 0.55;
    pointer-events: none;
  }

  .blob-1 {
    width: clamp(350px, 45vw, 650px);
    height: clamp(350px, 45vw, 650px);
    top: -10%;
    left: 50%;
    transform: translateX(-50%);
    background: radial-gradient(circle, rgba(0, 114, 255, 0.16) 0%, rgba(0, 198, 255, 0.08) 50%, transparent 75%);
  }

  .blob-2 {
    width: clamp(300px, 40vw, 550px);
    height: clamp(300px, 40vw, 550px);
    bottom: -5%;
    left: -5%;
    background: radial-gradient(circle, rgba(14, 165, 233, 0.14) 0%, rgba(99, 102, 241, 0.06) 50%, transparent 75%);
  }

  .blob-3 {
    width: clamp(300px, 40vw, 550px);
    height: clamp(300px, 40vw, 550px);
    bottom: -5%;
    right: -5%;
    background: radial-gradient(circle, rgba(59, 130, 246, 0.13) 0%, rgba(147, 51, 234, 0.05) 50%, transparent 75%);
  }

  /* Espaço Aberto, Harmonioso e Centralizado sem Espaços Gigantes */
  .light-platform-content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1100px;
    height: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: clamp(1.2rem, 3vh, 2.4rem);
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0;
  }

  /* Cabeçalho Centralizado com Alta Legibilidade */
  .platform-header-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(0.75rem, 1.8vh, 1.25rem);
    max-width: 980px;
    flex-shrink: 0;
  }

  .light-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(0, 114, 255, 0.08);
    border: 1px solid rgba(0, 114, 255, 0.22);
    color: #0072FF;
    padding: 0.35rem 1rem;
    border-radius: 9999px;
    font-size: clamp(0.75rem, 1.4vmin, 0.88rem);
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .live-pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: #0072FF;
    box-shadow: 0 0 10px rgba(0, 114, 255, 0.7);
    animation: dotPulse 1.8s infinite;
  }

  @keyframes dotPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(1.3); }
  }

  /* H1 Bem Maior e Destaque Visual */
  .light-platform-title {
    font-size: clamp(2.2rem, 4.5vw, 3.6rem);
    font-weight: 900;
    line-height: 1.15;
    letter-spacing: -0.035em;
    color: #0F172A;
    margin: 0;
    max-width: 22ch;
  }

  .light-platform-title strong {
    background: linear-gradient(135deg, #0072FF 0%, #00C6FF 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* Bloco Dinâmico com Título do Carrossel (Bem Maior e Destacado) */
  .dynamic-showcase-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: clamp(0.5rem, 1.2vh, 0.85rem);
    margin-top: 0.5rem;
    padding: 0;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    max-width: 850px;
    width: 100%;
  }

  /* Indicadores de Progresso */
  .showcase-step-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .step-dot {
    width: 28px;
    height: 4px;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: rgba(148, 163, 184, 0.4);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
  }

  .step-dot:hover {
    background: rgba(0, 114, 255, 0.5);
  }

  .step-dot.active {
    width: 48px;
    background: #0072FF;
  }

  /* Título do Carrossel Maior, Caixa Alta e Marcante */
  .showcase-main-title {
    font-size: clamp(1.4rem, 2.6vw, 2.2rem);
    font-weight: 900;
    color: #1E3A8A;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    margin: 0;
    line-height: 1.25;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  /* Palco do Carrossel com Navegação Lateral Elegante */
  .carousel-interactive-wrapper {
    position: relative;
    width: 100%;
    max-width: 900px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.5rem, 2vw, 1.5rem);
    margin: 0 auto;
  }

  /* Botões de Navegação com Aparência de Carrossel Moderno */
  .carousel-nav-btn {
    flex-shrink: 0;
    width: clamp(42px, 5vw, 54px);
    height: clamp(42px, 5vw, 54px);
    border-radius: 9999px;
    background: #FFFFFF;
    border: 1px solid rgba(0, 114, 255, 0.2);
    box-shadow: 0 4px 16px rgba(0, 114, 255, 0.12), 0 2px 6px rgba(15, 23, 42, 0.05);
    color: #0072FF;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 10;
  }

  .carousel-nav-btn:hover {
    background: #0072FF;
    color: #FFFFFF;
    border-color: #0072FF;
    transform: scale(1.08);
    box-shadow: 0 8px 24px rgba(0, 114, 255, 0.3);
  }

  .carousel-nav-btn:active {
    transform: scale(0.96);
  }

  /* Palco das Ilustrações: Bem Maior, Padronizado e com Efeito de Moldura Invisível Central */
  .character-morph-stage {
    position: relative;
    width: 100%;
    max-width: 680px;
    height: clamp(320px, 48vh, 480px);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
    overflow: hidden;
    user-select: none;
  }

  /* Slide com proporção e tamanho uniforme para todas as imagens */
  .morph-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.45s ease, transform 0.45s cubic-bezier(0.2, 0.9, 0.3, 1);
  }

  .morph-slide.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate3d(0, 0, 0);
    z-index: 2;
  }

  /* Animações de Deslocamento de Carrossel Real */
  .morph-slide.slide-from-right {
    animation: slideInFromRight 0.45s cubic-bezier(0.2, 0.9, 0.3, 1) forwards;
  }

  .morph-slide.slide-from-left {
    animation: slideInFromLeft 0.45s cubic-bezier(0.2, 0.9, 0.3, 1) forwards;
  }

  .morph-slide.slide-to-left {
    opacity: 0;
    visibility: visible;
    animation: slideOutToLeft 0.45s cubic-bezier(0.2, 0.9, 0.3, 1) forwards;
    z-index: 1;
  }

  .morph-slide.slide-to-right {
    opacity: 0;
    visibility: visible;
    animation: slideOutToRight 0.45s cubic-bezier(0.2, 0.9, 0.3, 1) forwards;
    z-index: 1;
  }

  @keyframes slideInFromRight {
    from {
      opacity: 0;
      transform: translate3d(50px, 0, 0) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translate3d(0, 0, 0) scale(1);
    }
  }

  @keyframes slideInFromLeft {
    from {
      opacity: 0;
      transform: translate3d(-50px, 0, 0) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translate3d(0, 0, 0) scale(1);
    }
  }

  @keyframes slideOutToLeft {
    from {
      opacity: 1;
      transform: translate3d(0, 0, 0) scale(1);
    }
    to {
      opacity: 0;
      transform: translate3d(-50px, 0, 0) scale(0.95);
    }
  }

  @keyframes slideOutToRight {
    from {
      opacity: 1;
      transform: translate3d(0, 0, 0) scale(1);
    }
    to {
      opacity: 0;
      transform: translate3d(50px, 0, 0) scale(0.95);
    }
  }

  /* Padronização visual exata para todas as 5 ilustrações */
  .morph-character-img {
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    object-position: center bottom;
    filter: drop-shadow(0 12px 30px rgba(0, 114, 255, 0.12));
    display: block;
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
    background: transparent !important;
    backface-visibility: hidden;
    transform-origin: center bottom;
  }

  /* Compensação ótica para a ilustração de Agendamentos (que possui corte mais baixo) */
  .morph-character-img.img-stonks {
    transform: scale(1.3) translateY(2%);
  }

  /* Responsivo Mobile */
  @media (max-width: 768px) {
    .light-platform-section {
      min-height: auto;
      max-height: none;
      padding: 4.5rem 1rem 2.5rem;
    }

    .light-platform-content {
      height: auto;
      gap: 1.25rem;
    }

    .light-platform-title {
      font-size: 1.85rem;
      max-width: 100%;
    }

    .showcase-main-title {
      font-size: 1.2rem;
    }

    .carousel-interactive-wrapper {
      max-width: 100%;
      gap: 0.25rem;
    }

    .carousel-nav-btn {
      width: 38px;
      height: 38px;
    }

    .character-morph-stage {
      max-width: 340px;
      height: 300px;
    }
  }
</style>
