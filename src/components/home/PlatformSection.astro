---
// PlatformSection.astro - Seção 2: Experiência 100% Tema Claro, Centralizada, Sem Card/Borda, com Imagens Alternadas
---

<section
  id="plataforma"
  aria-labelledby="plataforma-titulo"
  class="snap-page light-platform-section"
>
  <!-- Brilho Radial Suave Claro -->
  <div class="light-radial-glow" aria-hidden="true"></div>

  <!-- Fundo Lateral de Palavras Cinéticas em Tema Claro (Concentradas nas Bordas Livres) -->
  <div class="kinetic-words-background" aria-hidden="true">
    <!-- Coluna Esquerda: Palavras Livres -->
    <span class="kw-tag kw-left-1">RÁPIDO</span>
    <span class="kw-tag kw-left-2">EVOLUÇÃO EM 30S</span>
    <span class="kw-tag kw-left-3">EFICIÊNCIA MÁXIMA</span>
    <span class="kw-tag kw-left-4">AGENDA INTELIGENTE</span>
    <span class="kw-tag kw-left-5">MODERNO</span>
    <span class="kw-tag kw-left-6">ZERO BUROCRACIA</span>
    <span class="kw-tag kw-left-7">FLUIDEZ CLÍNICA</span>
    <span class="kw-tag kw-left-8">INTUITIVO</span>

    <!-- Coluna Direita: Palavras Livres -->
    <span class="kw-tag kw-right-1">FÁCIL DE USAR</span>
    <span class="kw-tag kw-right-2">ALTA PERFORMANCE</span>
    <span class="kw-tag kw-right-3">DUPLICAÇÃO EM 1 TOQUE</span>
    <span class="kw-tag kw-right-4">ZERO PAPEL</span>
    <span class="kw-tag kw-right-5">PRATICIDADE REAL</span>
    <span class="kw-tag kw-right-6">LIBERDADE TOTAL</span>
    <span class="kw-tag kw-right-7">WHATSAPP INTEGRADO</span>
    <span class="kw-tag kw-right-8">LGPD NATIVA</span>
  </div>

  <!-- Conteúdo Centralizado Aberto: Sem Card, Fundo Vazio e Sem Bordas -->
  <div class="light-platform-content">
    
    <!-- Topo do Texto: Selo + Título Fixo + Descrição Institucional -->
    <div class="platform-header-center">
      <div class="light-badge-pill">
        <span class="live-pulse-dot" aria-hidden="true"></span>
        <span>A PLATAFORMA MAIS RÁPIDA</span>
      </div>

      <h2 id="plataforma-titulo" class="light-platform-title">
        O sistema de gestão clínica <strong>mais eficiente e fluido</strong> do Brasil.
      </h2>

      <p class="light-platform-desc">
        Desenvolvido para a velocidade real da maca e do consultório. Você foca no paciente e o <strong>Pluri Fisio</strong> cuida do resto em segundos.
      </p>

      <!-- Bloco Dinâmico com Título Real Minimalista (Sem Fundo de Card, Sem Emojis) -->
      <div class="dynamic-showcase-header" id="dynamicShowcaseHeader">
        <div class="showcase-step-indicator" role="tablist" aria-label="Progresso dos diferenciais">
          <button type="button" class="step-dot active" data-index="0" aria-label="Alta Velocidade Clínica"></button>
          <button type="button" class="step-dot" data-index="1" aria-label="Alta Performance e Gestão"></button>
          <button type="button" class="step-dot" data-index="2" aria-label="100% Intuitivo e Descomplicado"></button>
          <button type="button" class="step-dot" data-index="3" aria-label="Estrutura Completa de Gestão"></button>
          <button type="button" class="step-dot" data-index="4" aria-label="Liberdade Total sem Papel"></button>
        </div>

        <h3 id="showcaseMainTitle" class="showcase-main-title">
          Alta Velocidade Clínica
        </h3>

        <p id="showcaseMainDesc" class="showcase-main-desc">
          Atendimento ágil na maca: evolução em 30 segundos e sem telas travadas.
        </p>
      </div>
    </div>

    <!-- Palco da Ilustração Totalmente Desobstruído (100% Livre de Tags em Cima) -->
    <div class="character-morph-stage" id="characterMorphStage" aria-label="Ilustrações dos diferenciais">
      <!-- 1. Alta Velocidade -->
      <img
        src="/branding/illustrations/fisio_ref_speed.webp"
        alt="Fisioterapeuta com celular e relógio indicando rapidez no atendimento"
        class="morph-character-img is-active"
        data-title="Alta Velocidade Clínica"
        data-desc="Atendimento ágil na maca: evolução completa em 30 segundos, sem telas travadas e sem formulários burocráticos."
        width="560"
        height="560"
        loading="eager"
      />
      <!-- 2. Alta Performance -->
      <img
        src="/branding/illustrations/fisio_ref_stonks.webp"
        alt="Fisioterapeuta com gráficos de alta performance e evolução clínica"
        class="morph-character-img"
        data-title="Alta Performance & Rentabilidade"
        data-desc="Mais rendimento por hora de consultório: gráficos claros de evolução, controle de retorno e zero retrabalho."
        width="560"
        height="560"
        loading="lazy"
      />
      <!-- 3. Simplicidade -->
      <img
        src="/branding/illustrations/fisio_ref_simple.webp"
        alt="Fisioterapeuta indicando simplicidade com sinal de positivo e check verde"
        class="morph-character-img"
        data-title="100% Intuitivo e Descomplicado"
        data-desc="Tão simples quanto usar o WhatsApp: você domina a plataforma no primeiro minuto, sem necessidade de treinamentos."
        width="560"
        height="560"
        loading="lazy"
      />
      <!-- 4. Organização Estruturada -->
      <img
        src="/branding/illustrations/fisio_ref_organized.webp"
        alt="Fisioterapeuta autônoma com estrutura e organização de grande clínica"
        class="morph-character-img"
        data-title="Estrutura Completa de Gestão"
        data-desc="A autonomia do atendimento individual com o poder de prontuário, agenda e relatórios de uma grande clínica."
        width="560"
        height="560"
        loading="lazy"
      />
      <!-- 5. Zero Papel -->
      <img
        src="/branding/illustrations/fisio_ref_nopaper.webp"
        alt="Fisioterapeuta livre de papéis com prontuário digital"
        class="morph-character-img"
        data-title="Liberdade Total sem Papel"
        data-desc="Fichas antigas e anexos salvos com segurança em nuvem criptografada: consultório limpo e rotina sem papelada."
        width="560"
        height="560"
        loading="lazy"
      />
    </div>

  </div>
</section>

<script>
  // Transição sincronizada e fluida: Título Real + Detalhe Descritivo + Ilustração
  function initCharacterMorph() {
    const stage = document.getElementById("characterMorphStage");
    const titleEl = document.getElementById("showcaseMainTitle");
    const descEl = document.getElementById("showcaseMainDesc");
    const dots = document.querySelectorAll<HTMLElement>(".step-dot");
    if (!stage) return;

    const images = stage.querySelectorAll<HTMLImageElement>(".morph-character-img");
    if (images.length < 2) return;

    let currentIndex = 0;
    let timer: number | null = null;

    function goToIndex(nextIndex: number) {
      if (nextIndex === currentIndex) return;
      const prevImg = images[currentIndex];
      prevImg.classList.remove("is-active");
      prevImg.classList.add("is-exiting");

      setTimeout(() => {
        prevImg.classList.remove("is-exiting");
      }, 550);

      currentIndex = nextIndex;
      const nextImg = images[currentIndex];
      nextImg.classList.add("is-active");

      // Atualiza dots indicadores
      dots.forEach((dot, idx) => {
        dot.classList.toggle("active", idx === currentIndex);
      });

      // Transição suave com fade do Título e da Descrição
      if (titleEl && nextImg.dataset.title) {
        titleEl.style.opacity = "0";
        titleEl.style.transform = "translate3d(0, -4px, 0)";
      }
      if (descEl && nextImg.dataset.desc) {
        descEl.style.opacity = "0";
        descEl.style.transform = "translate3d(0, 4px, 0)";
      }

      setTimeout(() => {
        if (titleEl && nextImg.dataset.title) {
          titleEl.textContent = nextImg.dataset.title;
          titleEl.style.opacity = "1";
          titleEl.style.transform = "translate3d(0, 0, 0)";
        }
        if (descEl && nextImg.dataset.desc) {
          descEl.textContent = nextImg.dataset.desc;
          descEl.style.opacity = "1";
          descEl.style.transform = "translate3d(0, 0, 0)";
        }
      }, 180);
    }

    function step() {
      const next = (currentIndex + 1) % images.length;
      goToIndex(next);
    }

    // Clique interativo nos dots indicadores
    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        const targetIdx = parseInt(dot.getAttribute("data-index") || "0", 10);
        goToIndex(targetIdx);
        stop();
        start();
      });
    });

    function start() {
      if (!timer) {
        timer = window.setInterval(step, 4800);
      }
    }

    function stop() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    // Pausa suave no hover
    stage.addEventListener("mouseenter", stop);
    stage.addEventListener("mouseleave", start);

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            start();
          } else {
            stop();
          }
        });
      }, { threshold: 0.15 });
      observer.observe(stage);
    } else {
      start();
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCharacterMorph);
  } else {
    initCharacterMorph();
  }
</script>

<style>
  /* Seção em Tema Claro Puro, Aberto e Sem Cartão Escuro */
  .light-platform-section {
    position: relative;
    width: 100%;
    min-height: 100vh;
    min-height: 100svh;
    max-height: 100vh;
    background: #F8FAFC !important;
    color: #0F172A !important;
    padding: calc(3.5rem + 1vh) clamp(1rem, 3.5vw, 3rem) 1.5vh;
    box-sizing: border-box;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    contain: paint;
  }

  /* Brilho Radial Azul Claro e Suave - Sem filter: blur pesado para 60fps */
  .light-radial-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate3d(-50%, -50%, 0);
    width: min(90vw, 850px);
    height: 550px;
    background: radial-gradient(circle, rgba(0, 114, 255, 0.09) 0%, rgba(56, 189, 248, 0.04) 45%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  /* Fundo Lateral de Palavras Cinéticas em Tema Claro (Concentradas nas Bordas Livres) */
  .kinetic-words-background {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
  }

  .kw-tag {
    position: absolute !important;
    display: inline-block !important;
    font-weight: 800;
    letter-spacing: -0.01em;
    color: rgba(15, 23, 42, 0.16);
    opacity: 0;
    animation: wordFloatFade 12s infinite ease-in-out;
    white-space: nowrap !important;
    text-transform: uppercase;
    user-select: none;
    pointer-events: none;
    backface-visibility: hidden;
    transform: translate3d(0, 0, 0);
  }

  /* Palavras Concentradas EXCLUSIVAMENTE nas Laterais Livres */
  /* Coluna Esquerda (0% a 22% da largura) */
  .kw-left-1 { top: 10%; left: 3%;  font-size: clamp(1rem, 2vw, 1.7rem); animation-delay: 0s;   color: rgba(0, 114, 255, 0.28); }
  .kw-left-2 { top: 22%; left: 6%;  font-size: clamp(0.9rem, 1.8vw, 1.45rem); animation-delay: 3s; }
  .kw-left-3 { top: 36%; left: 2%;  font-size: clamp(1.1rem, 2.2vw, 1.85rem); animation-delay: 6s; color: rgba(0, 114, 255, 0.32); }
  .kw-left-4 { top: 50%; left: 5%;  font-size: clamp(0.95rem, 1.9vw, 1.5rem); animation-delay: 1.5s; }
  .kw-left-5 { top: 62%; left: 3%;  font-size: clamp(1.15rem, 2.3vw, 1.9rem); animation-delay: 7.5s; }
  .kw-left-6 { top: 74%; left: 7%;  font-size: clamp(1rem, 2vw, 1.6rem); animation-delay: 4.2s; color: rgba(0, 114, 255, 0.28); }
  .kw-left-7 { top: 86%; left: 4%;  font-size: clamp(1.05rem, 2.1vw, 1.75rem); animation-delay: 9s; }
  .kw-left-8 { top: 94%; left: 8%;  font-size: clamp(0.95rem, 1.8vw, 1.45rem); animation-delay: 10.8s; }

  /* Coluna Direita (78% a 100% da largura) */
  .kw-right-1 { top: 12%; right: 4%; font-size: clamp(1.05rem, 2.1vw, 1.75rem); animation-delay: 1.8s; color: rgba(0, 114, 255, 0.28); }
  .kw-right-2 { top: 24%; right: 6%; font-size: clamp(1.15rem, 2.3vw, 1.9rem); animation-delay: 5s; }
  .kw-right-3 { top: 38%; right: 3%; font-size: clamp(0.95rem, 1.8vw, 1.5rem); animation-delay: 8.2s; color: rgba(0, 114, 255, 0.3); }
  .kw-right-4 { top: 52%; right: 5%; font-size: clamp(1.2rem, 2.4vw, 2rem);   animation-delay: 2.8s; }
  .kw-right-5 { top: 64%; right: 3%; font-size: clamp(1rem, 2vw, 1.65rem);  animation-delay: 6.8s; }
  .kw-right-6 { top: 76%; right: 7%; font-size: clamp(1.1rem, 2.2vw, 1.8rem); animation-delay: 10.2s; color: rgba(0, 114, 255, 0.28); }
  .kw-right-7 { top: 88%; right: 4%; font-size: clamp(0.95rem, 1.8vw, 1.5rem); animation-delay: 4.5s; }
  .kw-right-8 { top: 95%; right: 6%; font-size: clamp(1.05rem, 2vw, 1.7rem); animation-delay: 11.5s; }

  /* Animação Contínua e Fluida: Apenas transform 3D e opacity */
  @keyframes wordFloatFade {
    0% {
      opacity: 0;
      transform: translate3d(0, 16px, 0) scale(0.92);
    }
    18% {
      opacity: 0.95;
      transform: translate3d(0, 0, 0) scale(1);
    }
    45% {
      opacity: 0.9;
      transform: translate3d(0, -6px, 0) scale(1.02);
    }
    60% {
      opacity: 0;
      transform: translate3d(0, -18px, 0) scale(1.08);
    }
    100% {
      opacity: 0;
      transform: translate3d(0, -22px, 0) scale(1.1);
    }
  }

  /* Espaço Aberto e Centralizado */
  .light-platform-content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 960px;
    height: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    text-align: center;
    gap: clamp(0.4rem, 1.2vh, 1rem);
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0;
  }

  /* Cabeçalho Centralizado Compacto e Hierárquico */
  .platform-header-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(0.3rem, 0.8vh, 0.55rem);
    max-width: 840px;
    flex-shrink: 0;
  }

  .light-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: rgba(0, 114, 255, 0.08);
    border: 1px solid rgba(0, 114, 255, 0.22);
    color: #0072FF;
    padding: 0.2rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .live-pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: #0072FF;
    box-shadow: 0 0 8px rgba(0, 114, 255, 0.6);
    animation: dotPulse 1.8s infinite;
  }

  @keyframes dotPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(1.3); }
  }

  .light-platform-title {
    font-size: clamp(1.5rem, 2.3vw, 2.1rem);
    font-weight: 800;
    line-height: 1.16;
    letter-spacing: -0.03em;
    color: #0F172A;
    margin: 0;
  }

  .light-platform-title strong {
    background: linear-gradient(135deg, #0072FF 0%, #00C6FF 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .light-platform-desc {
    font-size: clamp(0.82rem, 1vw, 0.92rem);
    color: #475569;
    line-height: 1.4;
    margin: 0;
    max-width: 60ch;
  }

  .light-platform-desc strong {
    color: #0F172A;
  }

  /* Bloco Dinâmico com Título Real Minimalista (Clean, Sem Fundo de Card, Pura Tipografia) */
  .dynamic-showcase-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    margin-top: 0.6rem;
    padding: 0;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    max-width: 680px;
    width: 100%;
  }

  /* Indicadores de Progresso em Linhas Minimalistas e Clicáveis */
  .showcase-step-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.25rem;
  }

  .step-dot {
    width: 20px;
    height: 3px;
    padding: 0;
    border: none;
    border-radius: 999px;
    background: rgba(148, 163, 184, 0.35);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
  }

  .step-dot:hover {
    background: rgba(0, 114, 255, 0.45);
  }

  .step-dot.active {
    width: 34px;
    background: #0072FF;
  }

  .showcase-main-title {
    font-size: clamp(1.25rem, 1.85vw, 1.6rem);
    font-weight: 800;
    color: #0F172A;
    letter-spacing: -0.025em;
    margin: 0;
    line-height: 1.25;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .showcase-main-desc {
    font-size: clamp(0.84rem, 1.05vw, 0.94rem);
    font-weight: 500;
    color: #475569;
    margin: 0;
    line-height: 1.45;
    max-width: 60ch;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  /* Palco da Personagem 100% Desobstruído e Amplo */
  .character-morph-stage {
    position: relative;
    width: 100%;
    max-width: 520px;
    height: clamp(250px, 42vh, 360px);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    margin: 0 auto;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    flex-shrink: 1;
    user-select: none;
  }

  .morph-character-img {
    position: absolute !important;
    bottom: 0;
    top: auto;
    left: 50%;
    transform: translate3d(-50%, 12px, 0) scale(0.96);
    width: auto;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    object-fit: contain;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), transform 0.5s cubic-bezier(0.34, 1.25, 0.64, 1);
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
    background: transparent !important;
    pointer-events: none;
    backface-visibility: hidden;
  }

  .morph-character-img.is-active {
    opacity: 1 !important;
    visibility: visible !important;
    transform: translate3d(-50%, 0, 0) scale(1) !important;
    pointer-events: auto;
    z-index: 2;
  }

  .morph-character-img.is-exiting {
    opacity: 0 !important;
    visibility: visible !important;
    transform: translate3d(-50%, -10px, 0) scale(0.98) !important;
    z-index: 1;
  }

  /* Responsivo Mobile / Visão Vertical */
  @media (max-width: 960px) {
    .light-platform-section {
      min-height: auto;
      max-height: none;
      padding: 4.5rem 1rem 2.5rem;
    }

    .light-platform-content {
      height: auto;
      gap: 1.25rem;
    }

    .light-platform-title {
      font-size: 1.55rem;
    }

    .showcase-main-title {
      font-size: 1.15rem;
    }

    .showcase-main-desc {
      font-size: 0.8rem;
    }

    .character-morph-stage {
      max-width: 330px;
      height: 280px;
      margin-top: 0.5rem;
    }

    /* Palavras Cinéticas Visíveis na Faixa da Imagem e Laterais no Mobile */
    .kinetic-words-background {
      display: block;
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 1;
      overflow: hidden;
    }

    .kw-tag {
      font-weight: 800;
      letter-spacing: -0.01em;
      opacity: 0;
      animation: wordFloatFade 11s infinite ease-in-out;
    }

    /* Concentração na metade inferior (faixa da imagem de 45% a 92% e laterais) com fonte menor */
    .kw-left-1 { top: 48%; left: 3%;  font-size: 0.72rem; color: rgba(0, 114, 255, 0.32); animation-delay: 0s; }
    .kw-left-2 { top: 56%; left: 4%;  font-size: 0.65rem; color: rgba(15, 23, 42, 0.18); animation-delay: 3s; }
    .kw-left-3 { top: 65%; left: 2%;  font-size: 0.75rem; color: rgba(0, 114, 255, 0.35); animation-delay: 5.5s; }
    .kw-left-4 { top: 73%; left: 5%;  font-size: 0.68rem; color: rgba(15, 23, 42, 0.2);  animation-delay: 1.5s; }
    .kw-left-5 { top: 81%; left: 3%;  font-size: 0.75rem; color: rgba(15, 23, 42, 0.18); animation-delay: 7s; }
    .kw-left-6 { top: 88%; left: 6%;  font-size: 0.7rem;  color: rgba(0, 114, 255, 0.3);  animation-delay: 4.2s; }
    .kw-left-7 { top: 94%; left: 3%;  font-size: 0.68rem; color: rgba(15, 23, 42, 0.18); animation-delay: 8.5s; }
    .kw-left-8 { top: 52%; left: 26%; font-size: 0.62rem; color: rgba(0, 114, 255, 0.24); animation-delay: 10s; }

    .kw-right-1 { top: 50%; right: 3%;  font-size: 0.72rem; color: rgba(0, 114, 255, 0.32); animation-delay: 1.8s; }
    .kw-right-2 { top: 58%; right: 4%;  font-size: 0.75rem; color: rgba(15, 23, 42, 0.2);  animation-delay: 4.8s; }
    .kw-right-3 { top: 66%; right: 2%;  font-size: 0.68rem; color: rgba(0, 114, 255, 0.35); animation-delay: 7.8s; }
