---
// PlatformSection.astro - Seção 2: Declaração Fundamental com Proporções Humanas e Scroll Fluido
import PillarBadge from '../ui/PillarBadge.astro';
---

<section
  id="plataforma"
  aria-labelledby="plataforma-titulo"
  class="snap-page platform-section-clean"
>
  <!-- Fundo com atmosfera clean azulada da marca -->
  <div class="platform-bg-branding" aria-hidden="true">
    <div class="platform-radial-glow"></div>
  </div>

  <div class="platform-card-wrap">
    
    <!-- Lado Esquerdo: Conteúdo Textual com a Lógica de Bold Fundamental -->
    <div class="platform-text-column">
      <div class="platform-tag-pill">
        <span class="dot-indicator"></span>
        <span>EFICIÊNCIA & PRATICIDADE</span>
      </div>

      <!-- Frase Principal Solicitada -->
      <h2 id="plataforma-titulo" class="platform-statement">
        Nosso sistema <strong>resolve seus agendamentos</strong>, facilita o <strong>dia-a-dia do seu atendimento</strong> (e de toda sua equipe) e te traz <strong>eficiência e agilidade</strong>.
      </h2>

      <!-- Conclusão -->
      <p class="platform-punchline">
        Tudo isso de forma extremamente simples.
      </p>

      <!-- 3 Pílulas Essenciais da Solução -->
      <div class="platform-pillars-row">
        <PillarBadge text="Atendimentos Ágeis" icon="lightning" />
        <PillarBadge text="Gestão Completa" icon="dashboard" />
        <PillarBadge text="Máxima Eficiência" icon="pulse" />
      </div>
    </div>

    <!-- Lado Direito: Ilustração da Fisioterapeuta com Proporção Equilibrada -->
    <div class="platform-image-column">
      <div class="character-illustration-frame">
        <img
          src="/branding/illustrations/fisio_female_character.jpg"
          alt="Fisioterapeuta gerenciando agendamentos e atendimentos com agilidade no Pluri Fisio"
          class="character-image"
          width="400"
          height="400"
          loading="lazy"
        />
        <div class="character-caption-badge">
          <span class="badge-status-dot"></span>
          <span>Sem burocracia na rotina</span>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .platform-section-clean {
    position: relative;
    width: 100%;
    min-height: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #F8FAFC;
    padding: clamp(3.5rem, 6vw, 6rem) clamp(1rem, 3vw, 2.5rem);
    box-sizing: border-box;
    overflow: hidden;
  }

  .platform-bg-branding {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  .platform-radial-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(85vw, 800px);
    height: 450px;
    background: radial-gradient(circle, rgba(0, 198, 255, 0.12) 0%, rgba(0, 114, 255, 0.04) 50%, transparent 80%);
    filter: blur(80px);
    border-radius: 50%;
  }

  /* Card com proporções humanas e elegantes */
  .platform-card-wrap {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1140px;
    margin: 0 auto;
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: clamp(20px, 3vw, 28px);
    padding: clamp(1.8rem, 4vw, 3.5rem);
    box-shadow: 0 12px 36px -10px rgba(15, 23, 42, 0.06), 0 4px 16px -2px rgba(0, 114, 255, 0.04);
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    box-sizing: border-box;
  }

  /* Coluna de Texto */
  .platform-text-column {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    text-align: left;
    flex: 1.35;
    min-width: 0;
  }

  .platform-tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.3rem 0.85rem;
    border-radius: 9999px;
    background: #EFF6FF;
    border: 1px solid #BFDBFE;
    color: #0072FF;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1rem;
    flex-shrink: 0;
  }

  .dot-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #0072FF;
    box-shadow: 0 0 0 2px rgba(0, 114, 255, 0.25);
  }

  .platform-statement {
    font-size: clamp(1.35rem, 2.4vw, 2rem);
    font-weight: 500;
    line-height: 1.32;
    letter-spacing: -0.025em;
    color: #1E293B;
    margin: 0 0 0.85rem 0;
  }

  .platform-statement strong {
    font-weight: 800;
    color: #0F172A;
  }

  .platform-punchline {
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    font-weight: 700;
    color: #0072FF;
    line-height: 1.35;
    margin: 0 0 1.5rem 0;
  }

  .platform-pillars-row {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
    flex-shrink: 0;
  }

  /* Coluna de Imagem / Personagem */
  .platform-image-column {
    display: flex;
    justify-content: center;
    align-items: center;
    flex: 0.95;
    min-width: 0;
  }

  .character-illustration-frame {
    position: relative;
    width: 100%;
    max-width: 320px;
    aspect-ratio: 1 / 1;
    border-radius: 22px;
    overflow: hidden;
    background: #F0F9FF;
    border: 1px solid #E0F2FE;
    box-shadow: 0 10px 28px -6px rgba(0, 114, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .character-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    transition: transform 0.4s ease;
  }

  .character-illustration-frame:hover .character-image {
    transform: scale(1.04);
  }

  .character-caption-badge {
    position: absolute;
    bottom: 12px;
    left: 12px;
    background: rgba(255, 255, 255, 0.94);
    border: 1px solid rgba(226, 232, 240, 0.9);
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: 0.3rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.72rem;
    font-weight: 700;
    color: #0F172A;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    white-space: nowrap;
    z-index: 3;
  }

  .badge-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #10B981;
    box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.25);
  }

  /* Responsivo Mobile & Tablets (Scroll Natural sem travar) */
  @media (max-width: 860px) {
    .platform-section-clean {
      padding: 3rem 1.25rem;
    }

    .platform-card-wrap {
      flex-direction: column;
      text-align: center;
      gap: 1.75rem;
      padding: 2rem 1.25rem;
      border-radius: 20px;
    }

    .platform-text-column {
      align-items: center;
      text-align: center;
      width: 100%;
    }

    .platform-tag-pill {
      margin-bottom: 0.75rem;
    }

    .platform-statement {
      font-size: 1.25rem;
      line-height: 1.35;
      margin-bottom: 0.65rem;
    }

    .platform-punchline {
      font-size: 1.05rem;
      margin-bottom: 1.25rem;
    }

    .platform-pillars-row {
      justify-content: center;
      gap: 0.45rem;
      width: 100%;
    }

    .platform-image-column {
      width: 100%;
    }

    .character-illustration-frame {
      max-width: 220px;
      aspect-ratio: 1 / 1;
      border-radius: 18px;
    }

    .character-caption-badge {
      bottom: 8px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 0.68rem;
      padding: 0.25rem 0.65rem;
    }
  }
</style>
