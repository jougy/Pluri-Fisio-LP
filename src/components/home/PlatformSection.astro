---
// PlatformSection.astro - Seção 2: Experiência 100% Tema Claro, Centralizada, Sem Card/Borda, com Imagens Alternadas
---

<section
  id="plataforma"
  aria-labelledby="plataforma-titulo"
  class="snap-page light-platform-section"
>
  <!-- Brilho Radial Suave Claro -->
  <div class="light-radial-glow" aria-hidden="true"></div>

  <!-- Fundo Sutil de Palavras Cinéticas em Tema Claro (Appear, Zoom & Dissolve) -->
  <div class="kinetic-words-background" aria-hidden="true">
    <span class="kw-tag kw-1">Rápido</span>
    <span class="kw-tag kw-2">Fácil de Usar</span>
    <span class="kw-tag kw-3">Eficiência Máxima</span>
    <span class="kw-tag kw-4">Evolução em 30s</span>
    <span class="kw-tag kw-5">Zero Burocracia</span>
    <span class="kw-tag kw-6">Agenda Inteligente</span>
    <span class="kw-tag kw-7">Duplicação em 1 Toque</span>
    <span class="kw-tag kw-8">Zero Papel</span>
    <span class="kw-tag kw-9">Liberdade Total</span>
    <span class="kw-tag kw-10">WhatsApp Integrado</span>
    <span class="kw-tag kw-11">Controle Financeiro</span>
    <span class="kw-tag kw-12">Alta Performance</span>
    <span class="kw-tag kw-13">Foco no Paciente</span>
    <span class="kw-tag kw-14">Moderno</span>
    <span class="kw-tag kw-15">Intuitivo</span>
    <span class="kw-tag kw-16">Fluidez Clínica</span>
    <span class="kw-tag kw-17">LGPD Nativa</span>
    <span class="kw-tag kw-18">Prontuário Ágil</span>
    <span class="kw-tag kw-19">Praticidade Real</span>
    <span class="kw-tag kw-20">Mais Tempo Livre</span>
  </div>

  <!-- Conteúdo Centralizado Aberto: Sem Card, Fundo Vazio e Sem Bordas -->
  <div class="light-platform-content">
    
    <!-- Topo do Texto: Selo + Título + Descrição 100% Centralizados -->
    <div class="platform-header-center">
      <div class="light-badge-pill">
        <span class="live-pulse-dot"></span>
        <span>A PLATAFORMA MAIS RÁPIDA</span>
      </div>

      <h2 id="plataforma-titulo" class="light-platform-title">
        O sistema de gestão clínica <strong>mais eficiente e fluido</strong> do Brasil.
      </h2>

      <p class="light-platform-desc">
        Desenvolvido exclusivamente para a velocidade da sua maca e do seu consultório. Você cuida dos pacientes com total atenção e o <strong>Pluri Fisio</strong> cuida de todo o resto em segundos.
      </p>

      <!-- 3 Pílulas de Valor Imediato Claras e Transparentes -->
      <div class="platform-value-props">
        <div class="value-prop-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
          <span>Evolução em 30 segundos</span>
        </div>
        <div class="value-prop-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
          <span>Agenda com WhatsApp</span>
        </div>
        <div class="value-prop-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          <span>Segurança LGPD Absoluta</span>
        </div>
      </div>
    </div>

    <!-- Imagens Alternadas Dinamicamente: 5 Variações no Estilo Fiel às Referências -->
    <div class="character-morph-stage" id="characterMorphStage">
      <!-- 1. Alta Velocidade & Agilidade Clínica -->
      <img
        src="/branding/illustrations/fisio_ref_speed.png"
        alt="Fisioterapeuta com celular e relógio rápido indicando agilidade clínica"
        class="morph-character-img is-active"
        data-caption="⚡ Alta Velocidade: Atendimento ágil e sem telas travadas"
        width="460"
        height="460"
        loading="eager"
      />
      <!-- 2. Stonks & Crescimento Clínico -->
      <img
        src="/branding/illustrations/fisio_ref_stonks.png"
        alt="Fisioterapeuta com gráficos de alta performance e evolução"
        class="morph-character-img"
        data-caption="📈 Stonks: Mais rendimento e zero retrabalho no consultório"
        width="460"
        height="460"
        loading="lazy"
      />
      <!-- 3. Simplicidade & Zero Complicação -->
      <img
        src="/branding/illustrations/fisio_ref_simple.png"
        alt="Fisioterapeuta indicando simplicidade com sinal de positivo e check verde"
        class="morph-character-img"
        data-caption="✨ Simples de Usar: 100% intuitivo, como usar o WhatsApp"
        width="460"
        height="460"
        loading="lazy"
      />
      <!-- 4. Organização Estruturada de Clínica -->
      <img
        src="/branding/illustrations/fisio_ref_organized.png"
        alt="Fisioterapeuta autônoma com organização de clínica estruturada"
        class="morph-character-img"
        data-caption="🏥 Estrutura Completa: Autônomo com organização de grande clínica"
        width="460"
        height="460"
        loading="lazy"
      />
      <!-- 5. Zero Papel & Liberdade -->
      <img
        src="/branding/illustrations/fisio_ref_nopaper.png"
        alt="Fisioterapeuta livre de papéis com prontuário digital"
        class="morph-character-img"
        data-caption="🍃 Zero Papel: Fichas antigas no cofre digital e mais tempo livre"
        width="460"
        height="460"
        loading="lazy"
      />

      <!-- Legenda Dinâmica Flutuante Aberta -->
      <div class="morph-caption-indicator" id="morphCaption">
        <span class="caption-pulse"></span>
        <span id="morphCaptionText">⚡ Alta Velocidade: Atendimento ágil e sem telas travadas</span>
      </div>
    </div>

  </div>
</section>

<script>
  // Transição suave, lúdica e sem travamentos das 5 ilustrações da fisioterapeuta
  function initCharacterMorph() {
    const stage = document.getElementById("characterMorphStage");
    if (!stage) return;

    const images = stage.querySelectorAll<HTMLImageElement>(".morph-character-img");
    const captionText = document.getElementById("morphCaptionText");
    if (images.length < 2) return;

    let currentIndex = 0;
    let timer: number | null = null;

    function step() {
      const prevImg = images[currentIndex];
      prevImg.classList.remove("is-active");
      prevImg.classList.add("is-exiting");

      setTimeout(() => {
        prevImg.classList.remove("is-exiting");
      }, 700);

      currentIndex = (currentIndex + 1) % images.length;
      const nextImg = images[currentIndex];
      nextImg.classList.add("is-active");

      if (captionText && nextImg.dataset.caption) {
        captionText.style.opacity = "0";
        captionText.style.transform = "translate3d(0, 4px, 0)";
        setTimeout(() => {
          captionText.textContent = nextImg.dataset.caption || "";
          captionText.style.opacity = "1";
          captionText.style.transform = "translate3d(0, 0, 0)";
        }, 200);
      }
    }

    function start() {
      if (!timer) {
        timer = window.setInterval(step, 4500);
      }
    }

    function stop() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            start();
          } else {
            stop();
          }
        });
      }, { threshold: 0.1 });
      observer.observe(stage);
    } else {
      start();
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCharacterMorph);
  } else {
    initCharacterMorph();
  }
</script>

<style>
  /* Seção em Tema Claro Puro, Aberto e Sem Cartão Escuro */
  .light-platform-section {
    position: relative;
    width: 100%;
    min-height: auto;
    background: #F8FAFC !important;
    color: #0F172A !important;
    padding: clamp(4rem, 7vw, 7rem) clamp(1rem, 3.5vw, 3rem);
    box-sizing: border-box;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    contain: paint;
  }

  /* Brilho Radial Azul Claro e Suave - Sem filter: blur pesado para 60fps */
  .light-radial-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate3d(-50%, -50%, 0);
    width: min(90vw, 850px);
    height: 550px;
    background: radial-gradient(circle, rgba(0, 114, 255, 0.09) 0%, rgba(56, 189, 248, 0.04) 45%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  /* Fundo de 20 Palavras Vivas Adaptadas para Tema Claro */
  .kinetic-words-background {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .kw-tag {
    position: absolute !important;
    display: inline-block !important;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: rgba(15, 23, 42, 0.08);
    opacity: 0;
    animation: wordFloatFade 12s infinite ease-in-out;
    white-space: nowrap !important;
    text-transform: uppercase;
    user-select: none;
    pointer-events: none;
    will-change: transform, opacity;
    backface-visibility: hidden;
    transform: translate3d(0, 0, 0);
  }

  /* Distribuição Harmoniosa das 20 Palavras */
  .kw-1  { top: 6%;  left: 6%;  font-size: clamp(1.1rem, 2.4vw, 2.2rem); animation-delay: 0s; color: rgba(0, 114, 255, 0.2); }
  .kw-2  { top: 12%; right: 8%; font-size: clamp(1.2rem, 2.8vw, 2.3rem); animation-delay: 2.2s; }
  .kw-3  { top: 32%; left: 4%;  font-size: clamp(1.3rem, 3vw, 2.5rem); animation-delay: 4.8s; color: rgba(0, 114, 255, 0.22); }
  .kw-4  { top: 65%; left: 5%;  font-size: clamp(1.05rem, 2.2vw, 1.85rem); animation-delay: 7.2s; }
  .kw-5  { top: 82%; left: 14%; font-size: clamp(1.25rem, 2.6vw, 2.2rem); animation-delay: 1.4s; }
  .kw-6  { top: 8%;  left: 44%; font-size: clamp(1.1rem, 2.3vw, 1.9rem); animation-delay: 3.5s; }
  .kw-7  { top: 26%; right: 6%; font-size: clamp(1.25rem, 2.8vw, 2.4rem); animation-delay: 6s; color: rgba(0, 114, 255, 0.22); }
  .kw-8  { top: 50%; right: 7%; font-size: clamp(1.35rem, 3.2vw, 2.6rem); animation-delay: 8.5s; }
  .kw-9  { top: 76%; right: 6%; font-size: clamp(1.15rem, 2.5vw, 2rem); animation-delay: 10.2s; }
  .kw-10 { top: 89%; right: 22%; font-size: clamp(1.05rem, 2.1vw, 1.75rem); animation-delay: 4.1s; }
  .kw-11 { top: 20%; left: 22%; font-size: clamp(1rem, 2vw, 1.65rem); animation-delay: 9s; }
  .kw-12 { top: 64%; left: 28%; font-size: clamp(1.15rem, 2.5vw, 2.1rem); animation-delay: 11.2s; color: rgba(0, 114, 255, 0.2); }
  .kw-13 { top: 4%;  right: 28%; font-size: clamp(1rem, 2vw, 1.6rem); animation-delay: 1.7s; }
  .kw-14 { top: 46%; left: 3%;  font-size: clamp(1.25rem, 2.7vw, 2.3rem); animation-delay: 6.8s; }
  .kw-15 { top: 92%; left: 5%;  font-size: clamp(1.15rem, 2.3vw, 1.95rem); animation-delay: 12s; }
  .kw-16 { top: 18%; left: 62%; font-size: clamp(1.05rem, 2.1vw, 1.75rem); animation-delay: 8s; color: rgba(0, 114, 255, 0.18); }
  .kw-17 { top: 85%; right: 4%; font-size: clamp(1rem, 2vw, 1.6rem); animation-delay: 2.8s; }
  .kw-18 { top: 62%; right: 3%; font-size: clamp(1.15rem, 2.5vw, 2.1rem); animation-delay: 5.4s; }
  .kw-19 { top: 35%; right: 32%; font-size: clamp(1.05rem, 2.1vw, 1.75rem); animation-delay: 9.8s; }
  .kw-20 { top: 74%; left: 50%; font-size: clamp(1.2rem, 2.4vw, 1.95rem); animation-delay: 12.8s; color: rgba(0, 114, 255, 0.22); }

  /* Animação Contínua e Fluida: Apenas transform 3D e opacity (Zero blur, 60fps) */
  @keyframes wordFloatFade {
    0% {
      opacity: 0;
      transform: translate3d(0, 14px, 0) scale(0.92);
    }
    18% {
      opacity: 0.85;
      transform: translate3d(0, 0, 0) scale(1);
    }
    45% {
      opacity: 0.8;
      transform: translate3d(0, -6px, 0) scale(1.02);
    }
    60% {
      opacity: 0;
      transform: translate3d(0, -18px, 0) scale(1.08);
    }
    100% {
      opacity: 0;
      transform: translate3d(0, -22px, 0) scale(1.1);
    }
  }

  /* Espaço Aberto e Centralizado: Sem Card, Fundo Vazio e Sem Bordas */
  .light-platform-content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 980px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: clamp(1.75rem, 3.5vw, 2.75rem);
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    padding: 0;
  }

  /* Cabeçalho Centralizado */
  .platform-header-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.15rem;
    max-width: 820px;
  }

  .light-badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(0, 114, 255, 0.08);
    border: 1px solid rgba(0, 114, 255, 0.25);
    color: #0072FF;
    padding: 0.35rem 0.95rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .live-pulse-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: #0072FF;
    box-shadow: 0 0 10px rgba(0, 114, 255, 0.6);
    animation: dotPulse 1.8s infinite;
  }

  @keyframes dotPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(1.3); }
  }

  .light-platform-title {
    font-size: clamp(2rem, 3.8vw, 3rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: #0F172A;
    margin: 0;
  }

  .light-platform-title strong {
    background: linear-gradient(135deg, #0072FF 0%, #00C6FF 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .light-platform-desc {
    font-size: clamp(1rem, 1.5vw, 1.18rem);
    color: #475569;
    line-height: 1.6;
    margin: 0;
    max-width: 62ch;
  }

  .light-platform-desc strong {
    color: #0F172A;
  }

  /* Pílulas de Valor em Tema Claro */
  .platform-value-props {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.35rem;
  }

  .value-prop-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #FFFFFF;
    border: 1px solid rgba(226, 232, 240, 0.9);
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    font-size: clamp(0.8rem, 1.1vw, 0.88rem);
    font-weight: 600;
    color: #1E293B;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
  }

  .value-prop-item svg {
    color: #0072FF;
    flex-shrink: 0;
  }

  /* Palco da Personagem com Transição Suave e Lúdica: Sem Fundo, Sem Bordas */
  .character-morph-stage {
    position: relative;
    width: 100%;
    max-width: 480px;
    height: 480px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0.5rem auto 0 auto;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
  }

  .morph-character-img {
    position: absolute !important;
    top: 0;
    left: 50%;
    transform: translate3d(-50%, 14px, 0) scale(0.94);
    width: 100%;
    max-width: 480px;
    height: auto;
    object-fit: contain;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1), transform 0.65s cubic-bezier(0.34, 1.3, 0.64, 1);
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
    background: transparent !important;
    pointer-events: none;
    will-change: transform, opacity;
    backface-visibility: hidden;
  }

  .morph-character-img.is-active {
    opacity: 1 !important;
    visibility: visible !important;
    transform: translate3d(-50%, 0, 0) scale(1) !important;
    pointer-events: auto;
    z-index: 2;
  }

  .morph-character-img.is-exiting {
    opacity: 0 !important;
    visibility: visible !important;
    transform: translate3d(-50%, -10px, 0) scale(0.96) !important;
    z-index: 1;
  }

  /* Legenda Flutuante em Tema Claro */
  .morph-caption-indicator {
    position: absolute;
    bottom: -8px;
    left: 50%;
    transform: translate3d(-50%, 0, 0);
    background: #FFFFFF;
    border: 1px solid rgba(0, 114, 255, 0.25);
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08);
    border-radius: 9999px;
    padding: 0.45rem 1.15rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    font-weight: 700;
    color: #0F172A;
    white-space: nowrap;
    z-index: 10;
  }

  #morphCaptionText {
    transition: opacity 0.25s ease, transform 0.25s ease;
    display: inline-block;
  }

  .caption-pulse {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: #10B981;
    box-shadow: 0 0 8px rgba(16, 185, 129, 0.6);
  }

  /* Responsivo Mobile */
  @media (max-width: 860px) {
    .light-platform-section {
      padding: 3.5rem 1.25rem;
    }

    .light-platform-title {
      font-size: 1.75rem;
    }

    .light-platform-desc {
      font-size: 0.95rem;
    }

    .character-morph-stage {
      max-width: 320px;
      height: 320px;
    }

    .morph-character-img {
      max-width: 320px;
    }

    .morph-caption-indicator {
      font-size: 0.75rem;
      padding: 0.4rem 0.9rem;
      bottom: -12px;
    }
  }
</style>
