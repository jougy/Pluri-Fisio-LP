---
// PlatformSection.astro - Seção 2: Declaração Fundamental com Ilustração do Personagem da Marca
import PillarBadge from '../ui/PillarBadge.astro';
---

<section
  id="plataforma"
  aria-labelledby="plataforma-titulo"
  class="snap-page platform-section-clean"
>
  <!-- Fundo com atmosfera clean azulada da marca -->
  <div class="platform-bg-branding" aria-hidden="true">
    <div class="platform-radial-glow"></div>
  </div>

  <div class="platform-card-wrap">
    
    <!-- Lado Esquerdo: Conteúdo Textual com a Lógica de Bold Fundamental -->
    <div class="platform-text-column">
      <div class="platform-tag-pill">
        <span class="dot-indicator"></span>
        <span>EFICIÊNCIA & PRATICIDADE</span>
      </div>

      <!-- Frase Principal Solicitada -->
      <h2 id="plataforma-titulo" class="platform-statement">
        Nosso sistema <strong>resolve seus agendamentos</strong>, facilita o <strong>dia-a-dia do seu atendimento</strong> (e de toda sua equipe) e te traz <strong>eficiência e agilidade</strong>.
      </h2>

      <!-- Conclusão -->
      <p class="platform-punchline">
        Tudo isso de forma extremamente simples.
      </p>

      <!-- 3 Pílulas Essenciais da Solução -->
      <div class="platform-pillars-row">
        <PillarBadge text="Atendimentos Ágeis" icon="lightning" />
        <PillarBadge text="Gestão Completa" icon="dashboard" />
        <PillarBadge text="Máxima Eficiência" icon="pulse" />
      </div>
    </div>

    <!-- Lado Direito: Ilustração da Fisioterapeuta Adaptativa -->
    <div class="platform-image-column">
      <div class="character-illustration-frame">
        <img
          src="/branding/illustrations/fisio_female_character.jpg"
          alt="Fisioterapeuta gerenciando agendamentos e atendimentos com agilidade no Pluri Fisio"
          class="character-image"
          width="500"
          height="500"
          loading="lazy"
        />
        <div class="character-caption-badge">
          <span class="badge-status-dot"></span>
          <span>Sem burocracia na rotina</span>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .platform-section-clean {
    position: relative;
    width: 100vw;
    height: 100svh;
    min-height: 100svh;
    max-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #F8FAFC;
    padding: clamp(0.75rem, 3vmin, 2.5rem);
    overflow: hidden;
    box-sizing: border-box;
  }

  .platform-bg-branding {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  .platform-radial-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(85vw, 900px);
    height: min(70vh, 600px);
    background: radial-gradient(circle, rgba(0, 198, 255, 0.14) 0%, rgba(0, 114, 255, 0.05) 50%, transparent 80%);
    filter: blur(80px);
    border-radius: 50%;
  }

  /* Card adaptativo que preenche o viewport com proporções ideais */
  .platform-card-wrap {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: min(94vw, 1340px);
    height: min(86svh, 680px);
    margin: 0 auto;
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: clamp(18px, 2.5vmin, 28px);
    padding: clamp(1.2rem, 3.5vmin, 3.2rem) clamp(1.4rem, 4vmin, 3.8rem);
    box-shadow: 0 16px 40px -12px rgba(15, 23, 42, 0.07), 0 4px 16px -2px rgba(0, 114, 255, 0.05);
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    box-sizing: border-box;
  }

  /* Coluna de Texto */
  .platform-text-column {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    text-align: left;
    flex: 1.35;
    height: 100%;
    min-width: 0;
  }

  .platform-tag-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: clamp(0.25rem, 0.8vmin, 0.45rem) clamp(0.75rem, 1.8vmin, 1.1rem);
    border-radius: 9999px;
    background: #EFF6FF;
    border: 1px solid #BFDBFE;
    color: #0072FF;
    font-size: clamp(0.68rem, 1.2vmin, 0.8rem);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: clamp(0.6rem, 1.8vmin, 1.4rem);
    flex-shrink: 0;
  }

  .dot-indicator {
    width: clamp(6px, 0.9vmin, 8px);
    height: clamp(6px, 0.9vmin, 8px);
    border-radius: 50%;
    background: #0072FF;
    box-shadow: 0 0 0 2px rgba(0, 114, 255, 0.25);
  }

  .platform-statement {
    font-size: clamp(1.2rem, 2.7vmin, 2.15rem);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.03em;
    color: #1E293B;
    margin: 0 0 clamp(0.5rem, 1.5vmin, 1.2rem) 0;
  }

  .platform-statement strong {
    font-weight: 800;
    color: #0F172A;
  }

  .platform-punchline {
    font-size: clamp(0.95rem, 1.8vmin, 1.35rem);
    font-weight: 700;
    color: #0072FF;
    line-height: 1.35;
    margin: 0 0 clamp(1rem, 2.5vmin, 2rem) 0;
  }

  .platform-pillars-row {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 1.2vmin, 0.85rem);
    flex-wrap: wrap;
    flex-shrink: 0;
  }

  .pillar-pill {
    display: inline-flex;
    align-items: center;
    gap: clamp(0.4rem, 0.9vmin, 0.6rem);
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    color: #334155;
    font-size: clamp(0.75rem, 1.3vmin, 0.92rem);
    font-weight: 600;
    padding: clamp(0.45rem, 1.1vmin, 0.7rem) clamp(0.85rem, 1.8vmin, 1.25rem);
    border-radius: 9999px;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.03);
    white-space: nowrap;
    transition: all 0.2s ease;
  }

  .pillar-pill:hover {
    border-color: #BFDBFE;
    background: #F0F7FF;
    transform: translateY(-1px);
  }

  .pillar-pill svg {
    color: #0072FF;
    flex-shrink: 0;
    width: clamp(16px, 2vmin, 20px);
    height: clamp(16px, 2vmin, 20px);
  }

  /* Coluna de Imagem / Personagem - Escala Adaptativa Fluida */
  .platform-image-column {
    display: flex;
    justify-content: center;
    align-items: center;
    flex: 1;
    height: 100%;
    min-width: 0;
  }

  .character-illustration-frame {
    position: relative;
    width: 100%;
    max-width: min(38vw, 420px);
    height: 100%;
    max-height: min(72svh, 480px);
    aspect-ratio: 1 / 1;
    border-radius: clamp(18px, 2.5vmin, 26px);
    overflow: hidden;
    background: #F0F9FF;
    border: 1px solid #E0F2FE;
    box-shadow: 0 12px 32px -6px rgba(0, 114, 255, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .character-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    transition: transform 0.4s ease;
  }

  .character-illustration-frame:hover .character-image {
    transform: scale(1.04);
  }

  .character-caption-badge {
    position: absolute;
    bottom: clamp(10px, 2vmin, 18px);
    left: clamp(10px, 2vmin, 18px);
    background: rgba(255, 255, 255, 0.94);
    border: 1px solid rgba(226, 232, 240, 0.9);
    box-shadow: 0 4px 14px rgba(15, 23, 42, 0.08);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    padding: clamp(0.3rem, 0.8vmin, 0.45rem) clamp(0.65rem, 1.5vmin, 0.95rem);
    border-radius: 9999px;
    font-size: clamp(0.68rem, 1.1vmin, 0.78rem);
    font-weight: 700;
    color: #0F172A;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    white-space: nowrap;
    z-index: 3;
  }

  .badge-status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10B981;
    box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.25);
  }

  /* Responsivo Mobile & Telas Verticais (Garante 100% de preenchimento sem overflow e sem vácuo) */
  @media (max-width: 860px), (max-aspect-ratio: 1/1) {
    .platform-section-clean {
      height: 100svh;
      padding: clamp(0.5rem, 1.5vh, 1.25rem) clamp(0.75rem, 2vw, 1.25rem);
      align-items: center;
    }

    .platform-card-wrap {
      flex-direction: column;
      justify-content: space-evenly;
      text-align: center;
      gap: clamp(0.6rem, 1.5vh, 1.2rem);
      padding: clamp(0.9rem, 2vh, 1.6rem) clamp(0.85rem, 2vw, 1.4rem);
      width: 100%;
      max-width: 100%;
      height: 94svh;
      max-height: 94svh;
      border-radius: 20px;
    }

    .platform-text-column {
      align-items: center;
      text-align: center;
      flex: none;
      height: auto;
      width: 100%;
    }

    .platform-tag-pill {
      margin-bottom: clamp(0.4rem, 1vh, 0.75rem);
      padding: 0.2rem 0.65rem;
      font-size: 0.65rem;
    }

    .platform-statement {
      font-size: clamp(1rem, 3.8vw, 1.35rem);
      line-height: 1.28;
      margin-bottom: clamp(0.35rem, 0.9vh, 0.65rem);
      max-width: 95%;
    }

    .platform-punchline {
      font-size: clamp(0.85rem, 3.2vw, 1.05rem);
      margin-bottom: clamp(0.6rem, 1.2vh, 1rem);
    }

    .platform-pillars-row {
      justify-content: center;
      gap: 0.35rem;
      width: 100%;
    }

    .pillar-pill {
      padding: 0.35rem 0.65rem;
      font-size: clamp(0.68rem, 2.5vw, 0.78rem);
    }

    .platform-image-column {
      flex: 1;
      height: auto;
      width: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 0;
    }

    .character-illustration-frame {
      width: auto;
      height: 100%;
      max-height: clamp(160px, 34vh, 260px);
      aspect-ratio: 1 / 1;
      max-width: 100%;
      border-radius: 18px;
    }

    .character-caption-badge {
      bottom: 8px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 0.65rem;
      padding: 0.2rem 0.55rem;
      background: rgba(255, 255, 255, 0.96);
    }
  }

  /* Telas pequenas/baixas em altura (ex: iPhone SE ou landscape) */
  @media (max-height: 640px) {
    .platform-card-wrap {
      height: 96svh;
      padding: 0.6rem 0.9rem;
      gap: 0.4rem;
    }
    .platform-statement {
      font-size: 0.95rem;
      margin-bottom: 0.25rem;
    }
    .platform-punchline {
      font-size: 0.82rem;
      margin-bottom: 0.4rem;
    }
    .character-illustration-frame {
      max-height: 24vh;
    }
    .platform-tag-pill {
      display: none;
    }
  }
</style>
