---
import '../styles/clinical-theme.css';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
}

const {
  title = 'Pluri Fisio | Sistema para Fisioterapeutas e Clínicas no Celular',
  description = 'Organize fichas de pacientes, agenda com atalho para WhatsApp e controle do consultório direto no seu celular. Fácil de usar, sem complicação e com plano gratuito sem cartão.',
  canonicalUrl = 'https://plurifisio.com.br',
} = Astro.props;

// JSON-LD Structured Data Schema for SEO & GEO (Generative Engine Optimization for ChatGPT, Perplexity, Gemini, Claude)
const schemaData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://pluri.health/#organization",
      "name": "Pluri Health",
      "alternateName": [
        "PluriHealth",
        "Pluri-Health",
        "Pluri Health Brasil",
        "PluriHealth Tecnologia em Saúde"
      ],
      "legalName": "JOAO PAULO TADDEO DO VAL",
      "taxID": "59.955.007/0001-00",
      "url": "https://pluri.health",
      "sameAs": [
        "https://plurihealth.com.br",
        "https://plurifisio.com.br"
      ],
      "logo": "https://plurifisio.com.br/branding/logo/pluri_health_logo_gradient.png",
      "description": "Healthtech brasileira desenvolvedora do ecossistema de gestão clínica e prontuário eletrônico para equipes de saúde e fisioterapia."
    },
    {
      "@type": "SoftwareApplication",
      "@id": "https://plurifisio.com.br/#software",
      "name": "Pluri Fisio",
      "applicationCategory": "HealthApplication",
      "operatingSystem": "Web, iOS, Android",
      "url": "https://plurifisio.com.br",
      "publisher": {
        "@id": "https://pluri.health/#organization"
      },
      "provider": {
        "@id": "https://pluri.health/#organization"
      },
      "description": "Sistema de gestão clínica e fichas de pacientes direto no celular, com agenda integrada, atalho rápido para WhatsApp e controle de atendimentos para fisioterapia e saúde.",
      "offers": [
        {
          "@type": "Offer",
          "name": "Plano Gratuito por Uso",
          "price": "0.00",
          "priceCurrency": "BRL",
          "description": "20 atendimentos clínicos, até 5 pacientes cadastrados e 4 acessos simultâneos sem limite de tempo e sem cartão de crédito."
        },
        {
          "@type": "Offer",
          "name": "Profissional Solo",
          "price": "40.00",
          "priceCurrency": "BRL",
          "billingDuration": "P1M",
          "description": "Pacientes e atendimentos ilimitados para 1 profissional titular."
        },
        {
          "@type": "Offer",
          "name": "Clínica com Equipe",
          "price": "60.00",
          "priceCurrency": "BRL",
          "billingDuration": "P1M",
          "description": "Até 30 colaboradores, 2 acessos simultâneos inclusos, controle de salas e gestão multi-profissional."
        }
      ]
    },
    {
      "@type": "MedicalWebPage",
      "@id": "https://plurifisio.com.br/#medicalpage",
      "name": "Pluri Fisio - Sistema para Consultórios de Fisioterapia e Saúde",
      "url": "https://plurifisio.com.br",
      "about": [
        { "@type": "Thing", "name": "Ficha e Prontuário do Paciente" },
        { "@type": "Thing", "name": "Evolução do Atendimento Clínico" },
        { "@type": "Thing", "name": "Gestão de Consultórios de Fisioterapia" },
        { "@type": "Thing", "name": "Agenda de Atendimentos no WhatsApp" },
        { "@type": "Thing", "name": "Segurança de Dados e LGPD na Saúde" }
      ]
    },
    {
      "@type": "FAQPage",
      "@id": "https://plurifisio.com.br/#faq",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Preciso de computador para usar ou funciona só no celular?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Funciona perfeitamente direto no celular, tablet ou computador, sem precisar instalar nada difícil. Basta abrir no navegador e usar com a mesma facilidade do WhatsApp."
          }
        },
        {
          "@type": "Question",
          "name": "Como funciona o Plano Gratuito do Pluri Fisio?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "O plano gratuito é vitalício e por quantidade de uso: inclui até 20 atendimentos clínicos, 5 pacientes cadastrados e 4 acessos simultâneos, sem prazo de expiração e sem exigir cartão de crédito."
          }
        },
        {
          "@type": "Question",
          "name": "Como funciona para passar minhas fichas antigas de papel?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Nossa equipe realiza a transferência gratuita de todo o seu histórico e lista de pacientes para o Pluri Fisio sem nenhum custo adicional."
          }
        },
        {
          "@type": "Question",
          "name": "Os dados dos pacientes ficam seguros perante a lei (LGPD)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sim! Todos os registros são protegidos em cofre digital seguro na nuvem, garantindo sigilo e conformidade integral com a LGPD e resoluções do CREFITO e CFM."
          }
        }
      ]
    }
  ]
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Favicons Oficiais Pluri Health (Compatibilidade Total com Google Search, PWA e Browsers) -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Webmaster Verification Tags (Google Search Console & Bing Webmaster Tools) -->
    <meta name="google-site-verification" content="google-site-verification-token" />
    <meta name="msvalidate.01" content="msvalidate-token" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://plurifisio.com.br/branding/logo/pluri_health_logo_gradient.png" />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://plurifisio.com.br/branding/logo/pluri_health_logo_gradient.png" />

    <!-- Theme Color Light Clean -->
    <meta name="theme-color" content="#f8fafc" />

    <!-- Google Fonts Preconnect & Optimized Non-blocking Load (Figtree + Outfit) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800&display=swap" />
    </noscript>

    <!-- Preload Hero Brand Logo for Fast LCP -->
    <link rel="preload" as="image" href="/branding/logo/pluri_health_icon_gradient.svg" type="image/svg+xml" fetchpriority="high" />

    <!-- DNS Prefetch & Preconnect for app destination -->
    <link rel="preconnect" href="https://app.plurifisio.com.br" crossorigin />
    <link rel="dns-prefetch" href="https://app.plurifisio.com.br" />

    <!-- JSON-LD Schema Script for Search Engines & Generative AI Indexing -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />

    <!-- Google Tag / GA4, Clarity e Meta Pixel com carregamento diferido e seguro -->
    <script src="/scripts/analytics-loader.js" defer></script>
    <noscript>
      <img height="1" width="1" style="display:none"
        src="https://www.facebook.com/tr?id=1073846021935349&ev=PageView&noscript=1"
        alt=""
      />
    </noscript>
    <!-- End Meta Pixel Code -->
  </head>
  <body>
    <slot />
  </body>
</html>
